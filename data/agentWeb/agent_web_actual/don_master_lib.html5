}</code></pre></article>
<article id="actual-12-55"><h2>don_item_value <small>[12.55]</small></h2><p><code>int don_item_value(item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:437–440</p><p>function_actual12.55.2</p><pre><code>int don_item_value(item it) {
    don_price_quote q = don_price(it);
    return max(q.value, autosell_price(it));
}</code></pre></article>
<article id="actual-12-56"><h2>don_price_at_most <small>[12.56]</small></h2><p><code>boolean don_price_at_most(item it, int max_price)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:442–445</p><p>function_actual12.56.2</p><pre><code>boolean don_price_at_most(item it, int max_price) {
    if (max_price &lt;= 0) return false;
    return don_price(it).value &lt;= max_price;
}</code></pre></article>
<article id="actual-12-57"><h2>don_profit <small>[12.57]</small></h2><p><code>int don_profit(item output, item input, int input_count)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:447–449</p><p>function_actual12.57.2</p><pre><code>int don_profit(item output, item input, int input_count) {
    return don_item_value(output) - (don_item_value(input) * input_count);
}</code></pre></article>
<article id="actual-12-58"><h2>don_use_familiar <small>[12.58]</small></h2><p><code>boolean don_use_familiar(familiar fam)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:455–459</p><p>function_actual12.58.2</p><pre><code>boolean don_use_familiar(familiar fam) {
    if (!have_familiar(fam)) return false;
    use_familiar(fam);
    return my_familiar() == fam;
}</code></pre></article>
<article id="actual-12-59"><h2>don_equip_familiar_default <small>[12.59]</small></h2><p><code>boolean don_equip_familiar_default(familiar fam)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:461–475</p><p>function_actual12.59.2</p><pre><code>boolean don_equip_familiar_default(familiar fam) {
    if (!have_familiar(fam)) return false;
    familiar old = my_familiar();
    use_familiar(fam);
    item gear = familiar_equipment(fam);
    boolean ok = true;

    if (gear != $item[none]) {
        if (!retrieve_item(1, gear)) ok = false;
        else ok = equip($slot[familiar], gear);
    }

    if (old != $familiar[none] &amp;&amp; old != fam) use_familiar(old);
    return ok;
}</code></pre></article>
<article id="actual-12-60"><h2>don_train_familiar <small>[12.60]</small></h2><p><code>boolean don_train_familiar(familiar fam, int base_weight_goal)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:477–485</p><p>function_actual12.60.2</p><pre><code>boolean don_train_familiar(familiar fam, int base_weight_goal) {
    if (!have_familiar(fam)) return false;
    if (familiar_weight(fam) &gt;= base_weight_goal) return true;
    familiar old = my_familiar();
    use_familiar(fam);
    boolean ok = cli_execute(&quot;train base &quot; + base_weight_goal);
    if (old != $familiar[none] &amp;&amp; old != fam) use_familiar(old);
    return ok &amp;&amp; familiar_weight(fam) &gt;= base_weight_goal;
}</code></pre></article>
<article id="actual-12-61"><h2>don_save_outfit <small>[12.61]</small></h2><p><code>boolean don_save_outfit(string name)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:487–490</p><p>function_actual12.61.2</p><pre><code>boolean don_save_outfit(string name) {
    if (name == &quot;&quot;) return false;
    return cli_execute(&quot;outfit save &quot; + name);
}</code></pre></article>
<article id="actual-12-62"><h2>don_wear_outfit <small>[12.62]</small></h2><p><code>boolean don_wear_outfit(string name)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:492–495</p><p>function_actual12.62.2</p><pre><code>boolean don_wear_outfit(string name) {
    if (name == &quot;&quot;) return false;
    return outfit(name);
}</code></pre></article>
<article id="actual-12-63"><h2>don_unequip <small>[12.63]</small></h2><p><code>boolean don_unequip(item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:497–500</p><p>function_actual12.63.2</p><pre><code>boolean don_unequip(item it) {
