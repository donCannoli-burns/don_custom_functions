}</code></pre></article>
<article id="actual-12-64"><h2>don_song_limit <small>[12.64]</small></h2><p><code>int don_song_limit()</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:506–511</p><p>function_actual12.64.2</p><pre><code>int don_song_limit() {
    int limit = 3;
    if (boolean_modifier(&quot;Four Songs&quot;)) limit += 1;
    limit += numeric_modifier(&quot;Additional Song&quot;).to_int();
    return limit;
}</code></pre></article>
<article id="actual-12-65"><h2>don_song_count <small>[12.65]</small></h2><p><code>int don_song_count()</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:513–521</p><p>function_actual12.65.2</p><pre><code>int don_song_count() {
    int count = 0;
    int[effect] active = my_effects();
    foreach ef, turns in active {
        skill source = to_skill(ef);
        if (source != $skill[none] &amp;&amp; source.class == $class[Accordion Thief] &amp;&amp; source.buff) count += 1;
    }
    return count;
}</code></pre></article>
<article id="actual-12-66"><h2>don_recover_hp <small>[12.66]</small></h2><p><code>boolean don_recover_hp(float target_fraction)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:523–528</p><p>function_actual12.66.2</p><pre><code>boolean don_recover_hp(float target_fraction) {
    target_fraction = don_clamp(target_fraction, 0.0, 1.0);
    int target = ceil(my_maxhp() * target_fraction).to_int();
    if (my_hp() &gt;= target) return true;
    return restore_hp(target);
}</code></pre></article>
<article id="actual-12-67"><h2>don_recover_mp <small>[12.67]</small></h2><p><code>boolean don_recover_mp(float target_fraction)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:530–535</p><p>function_actual12.67.2</p><pre><code>boolean don_recover_mp(float target_fraction) {
    target_fraction = don_clamp(target_fraction, 0.0, 1.0);
    int target = ceil(my_maxmp() * target_fraction).to_int();
    if (my_mp() &gt;= target) return true;
    return restore_mp(target);
}</code></pre></article>
<article id="actual-12-68"><h2>don_quest_step <small>[12.68]</small></h2><p><code>int don_quest_step(string quest_property)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:541–548</p><p>function_actual12.68.2</p><pre><code>int don_quest_step(string quest_property) {
    string state = get_property(quest_property);
    if (state == &quot;&quot; || state == &quot;unstarted&quot;) return -1;
    if (state == &quot;started&quot;) return 0;
    if (state == &quot;finished&quot;) return 999;
    if (starts_with(state, &quot;step&quot;)) return substring(state, 4).to_int();
    return 0;
}</code></pre></article>
<article id="actual-12-69"><h2>don_quest_started <small>[12.69]</small></h2><p><code>boolean don_quest_started(string quest_property)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:550–552</p><p>function_actual12.69.2</p><pre><code>boolean don_quest_started(string quest_property) {
    return don_quest_step(quest_property) &gt;= 0;
}</code></pre></article>
<article id="actual-12-70"><h2>don_quest_finished <small>[12.70]</small></h2><p><code>boolean don_quest_finished(string quest_property)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:554–556</p><p>function_actual12.70.2</p><pre><code>boolean don_quest_finished(string quest_property) {
    return get_property(quest_property) == &quot;finished&quot;;
}</code></pre></article>
<article id="actual-12-71"><h2>don_quest_at_least <small>[12.71]</small></h2><p><code>boolean don_quest_at_least(string quest_property, int step)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:558–562</p><p>function_actual12.71.2</p><pre><code>boolean don_quest_at_least(string quest_property, int step) {
    int current = don_quest_step(quest_property);
    if (current == 999) return true;
    return current &gt;= step;
}</code></pre></article>
