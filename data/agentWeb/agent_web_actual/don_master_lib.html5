<article id="actual-12-41"><h2>don_hp_fraction <small>[12.41]</small></h2><p><code>float don_hp_fraction()</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:246–249</p><p>function_actual12.41.2</p><pre><code>float don_hp_fraction() {
    if (my_maxhp() &lt;= 0) return 0.0;
    return my_hp().to_float() / my_maxhp().to_float();
}</code></pre></article>
<article id="actual-12-42"><h2>don_mp_fraction <small>[12.42]</small></h2><p><code>float don_mp_fraction()</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:251–254</p><p>function_actual12.42.2</p><pre><code>float don_mp_fraction() {
    if (my_maxmp() &lt;= 0) return 0.0;
    return my_mp().to_float() / my_maxmp().to_float();
}</code></pre></article>
<article id="actual-12-43"><h2>don_print_snapshot <small>[12.43]</small></h2><p><code>void don_print_snapshot()</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:280–292</p><p>function_actual12.43.2</p><pre><code>void don_print_snapshot() {
    don_state s = don_snapshot();
    don_header(&quot;STATE SNAPSHOT&quot;);
    print(&quot;Player: &quot; + s.player + &quot; | level &quot; + s.level + &quot; | ascensions &quot; + s.ascensions);
    print(&quot;Adventures: &quot; + s.adventures + &quot; | Meat: &quot; + don_rnum(s.meat));
    print(&quot;HP: &quot; + s.hp + &quot;/&quot; + s.maxhp + &quot; | MP: &quot; + s.mp + &quot;/&quot; + s.maxmp);
    print(&quot;Fullness: &quot; + s.fullness + &quot;/&quot; + s.fullness_limit);
    print(&quot;Inebriety: &quot; + s.inebriety + &quot;/&quot; + s.inebriety_limit);
    print(&quot;Spleen: &quot; + s.spleen + &quot;/&quot; + s.spleen_limit);
    print(&quot;Familiar: &quot; + s.fam + &quot; | Location: &quot; + s.loc);
    print(&quot;Aftercore: &quot; + don_bool_word(s.aftercore) + &quot; | Overdrunk: &quot; + don_bool_word(s.overdrunk));
    don_footer();
}</code></pre></article>
<article id="actual-12-44"><h2>don_inventory_amount <small>[12.44]</small></h2><p><code>int don_inventory_amount(item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:298–298</p><p>function_actual12.44.2</p><pre><code>int don_inventory_amount(item it) { return item_amount(it); }</code></pre></article>
<article id="actual-12-45"><h2>don_owned_amount <small>[12.45]</small></h2><p><code>int don_owned_amount(item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:300–302</p><p>function_actual12.45.2</p><pre><code>int don_owned_amount(item it) {
    return item_amount(it) + equipped_amount(it) + closet_amount(it) + storage_amount(it);
}</code></pre></article>
<article id="actual-12-46"><h2>don_owned_amount <small>[12.46]</small></h2><p><code>int don_owned_amount(item it, boolean include_display, boolean include_shop, boolean include_stash)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:304–310</p><p>function_actual12.46.2</p><pre><code>int don_owned_amount(item it, boolean include_display, boolean include_shop, boolean include_stash) {
    int amount = don_owned_amount(it);
    if (include_display) amount += display_amount(it);
    if (include_shop) amount += shop_amount(it);
    if (include_stash) amount += stash_amount(it);
    return amount;
}</code></pre></article>
<article id="actual-12-47"><h2>don_have <small>[12.47]</small></h2><p><code>boolean don_have(item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:312–314</p><p>function_actual12.47.2</p><pre><code>boolean don_have(item it) {
    return don_owned_amount(it) &gt; 0;
}</code></pre></article>
<article id="actual-12-48"><h2>don_need <small>[12.48]</small></h2><p><code>boolean don_need(item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:316–318</p><p>function_actual12.48.2</p><pre><code>boolean don_need(item it) {
    return don_owned_amount(it) == 0;
}</code></pre></article>
<article id="actual-12-49"><h2>don_possess_inventory_closet_equipped <small>[12.49]</small></h2><p><code>boolean don_possess_inventory_closet_equipped(item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:320–322</p><p>function_actual12.49.2</p><pre><code>boolean don_possess_inventory_closet_equipped(item it) {
    return item_amount(it) &gt; 0 || closet_amount(it) &gt; 0 || have_equipped(it);
}</code></pre></article>
<article id="actual-12-50"><h2>don_familiar_equipped_amount <small>[12.50]</small></h2><p><code>int don_familiar_equipped_amount(item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:324–331</p><p>function_actual12.50.2</p><pre><code>int don_familiar_equipped_amount(item it) {
    int amount = 0;
    foreach fam in $familiars[] {
        if (!have_familiar(fam)) continue;
        if (familiar_equipped_equipment(fam) == it) amount += 1;
    }
    return amount;
}</code></pre></article>
<article id="actual-12-51"><h2>don_true_owned_amount <small>[12.51]</small></h2><p><code>int don_true_owned_amount(item it, boolean include_stash)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:333–337</p><p>function_actual12.51.2</p><pre><code>int don_true_owned_amount(item it, boolean include_stash) {
    int amount = don_owned_amount(it, true, true, include_stash);
    amount += don_familiar_equipped_amount(it);
    return amount;
}</code></pre></article>
<article id="actual-12-52"><h2>don_retrieve <small>[12.52]</small></h2><p><code>boolean don_retrieve(int amount, item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:339–343</p><p>function_actual12.52.2</p><pre><code>boolean don_retrieve(int amount, item it) {
    if (amount &lt;= 0) return true;
    if (item_amount(it) &gt;= amount) return true;
    return retrieve_item(amount, it);
}</code></pre></article>
<article id="actual-12-53"><h2>don_use_any <small>[12.53]</small></h2><p><code>boolean don_use_any(int amount, item it)</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:379–386</p><p>function_actual12.53.2</p><pre><code>boolean don_use_any(int amount, item it) {
    if (amount &lt;= 0) return true;
    if (item_amount(it) &lt; amount &amp;&amp; !retrieve_item(amount, it)) return false;
    if (use(amount, it)) return true;
    if (eat(amount, it)) return true;
    if (drink(amount, it)) return true;
    return false;
}</code></pre></article>
<article id="actual-12-54"><h2>don_value_of_adventure <small>[12.54]</small></h2><p><code>int don_value_of_adventure()</code></p><p>don-master-ash-lib/scripts/don_master_lib.ash:392–396</p><p>function_actual12.54.2</p><pre><code>int don_value_of_adventure() {
    int voa = get_property(&quot;valueOfAdventure&quot;).to_int();
