<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>don_custom_functions · actual</title><style>body{max-width:1050px;margin:20px auto;padding:18px;font:15px/1.5 system-ui;color:#000;background:#fcfcff}header{background:#abd1f3;border:2px solid black;padding:15px}article{padding:14px;border:1px solid #444;background:white;margin:12px 0;overflow-wrap:anywhere}article:target{outline:3px solid #4a94c6}a{color:#14537a}code,pre{font-family:monospace}pre{padding:12px;background:#dff7fa;white-space:pre-wrap;overflow-wrap:anywhere;max-height:600px;overflow:auto}input{box-sizing:border-box;width:100%;padding:10px;border:2px solid #000}details{padding:5px}small{color:#444}</style></head><body><header><h1>don_custom_functions · actual</h1><p>Agent Web v0.1 — read-only static source index, no model embeddings or executable functions</p></header><article id="actual-11-1"><h2>possessItem <small>[11.1]</small></h2><p><code>boolean possessItem(item thingy)</code></p><p>scripts/don_custom_functions.ash:69–78</p><p>function_actual11.1.2</p><pre><code>boolean possessItem(item thingy) {
    // Historically this function unequipped matching equipment; retain that
    // behavior for callers relying on it. For a pure test, use don_have().
    if (item_amount(thingy) &gt; 0 || closet_amount(thingy) &gt; 0) return true;
    if (!have_equipped(thingy)) return false;
    if (!cli_execute(&quot;unequip &quot; + thingy)) {
        don_warning(&quot;possessItem(): could not unequip &quot; + thingy);
    }
    return true;
}</code></pre></article>
<article id="actual-11-2"><h2>IamLegendary <small>[11.2]</small></h2><p><code>boolean IamLegendary()</code></p><p>scripts/don_custom_functions.ash:80–91</p><p>function_actual11.2.2</p><pre><code>boolean IamLegendary() {
    if (MuscleClass())
        return possessItem($item[Hammer of Smiting]) ||
               possessItem($item[Chelonian Morningstar]);
    if (MoxieClass())
        return possessItem($item[Shagadelic Disco Banjo]) ||
               possessItem($item[Squeezebox of the Ages]);
    if (MysticalityClass())
        return possessItem($item[Greek Pasta Spoon of Peril]) ||
               possessItem($item[17-alarm Saucepan]);
    return false;
}</code></pre></article>
<article id="actual-11-3"><h2>IamEpic <small>[11.3]</small></h2><p><code>boolean IamEpic()</code></p><p>scripts/don_custom_functions.ash:93–105</p><p>function_actual11.3.2</p><pre><code>boolean IamEpic() {
    if (IamLegendary()) return true;
    if (MuscleClass())
        return possessItem($item[Bjorn&#39;s Hammer]) ||
               possessItem($item[Mace of the Tortoise]);
    if (MoxieClass())
        return possessItem($item[Rock and Roll Legend]) ||
               possessItem($item[Disco Banjo]);
    if (MysticalityClass())
        return possessItem($item[Pasta Spoon of Peril]) ||
               possessItem($item[5-Alarm Saucepan]);
    return false;
}</code></pre></article>
<article id="actual-11-4"><h2>CheckFortune <small>[11.4]</small></h2><p><code>string CheckFortune(boolean autoeat)</code></p><p>scripts/don_custom_functions.ash:107–157</p><p>function_actual11.4.2</p><pre><code>string CheckFortune(boolean autoeat) {
    // Bounded: at most one fortune cookie consumed per invocation.
    string counters = get_property(&quot;relayCounters&quot;);
    matcher finder = create_matcher(&quot;(\\d+):Fortune Cookie&quot;, counters);
    int[int] turns;
    int index = 0;

    while (finder.find()) {
        int remaining = finder.group(1).to_int() - my_turncount();
        if (remaining &gt; 0) {
            index += 1;
            turns[index] = remaining;
        }
    }

    if (index == 0 &amp;&amp; my_fullness() &lt; fullness_limit() &amp;&amp; my_meat() &gt; 40) {
        boolean approve = autoeat;
        if (!autoeat) approve = user_confirm(&quot;Eat one fortune cookie?&quot;);
        if (approve) {
            if (!eatsilent(1, $item[fortune cookie])) {
                return &quot;&lt;b&gt;&lt;font color=#ff0000&gt;Failed to eat a Fortune Cookie.&lt;/font&gt;&lt;/b&gt;&quot;;
            }
            // Only re-read counters. Do not recurse into another eat/prompt.
            counters = get_property(&quot;relayCounters&quot;);
            finder = create_matcher(&quot;(\\d+):Fortune Cookie&quot;, counters);
            while (finder.find()) {
                int remaining = finder.group(1).to_int() - my_turncount();
                if (remaining &gt; 0) {
                    index += 1;
                    turns[index] = remaining;
                }
            }
        }
    }

    string result = &quot;&quot;;
    if (index &gt; 0) {
        result = &quot;&lt;b&gt;&lt;font color=#365f91&gt;Semi-rare counters active: &quot; + index + &quot;.&lt;br /&gt;&quot;;
        foreach i, remaining in turns {
            result += &quot;Semi-rare in &lt;font color=#00b0f0&gt;&quot; + remaining + &quot;&lt;/font&gt; turns.&lt;br /&gt;&quot;;
        }
        result += &quot;&lt;/font&gt;&lt;/b&gt;&quot;;
    } else if (my_fullness() &gt;= fullness_limit()) {
        result = &quot;&lt;b&gt;&lt;font color=#ff0000&gt;No future fortune counter; too full to eat a cookie.&lt;br /&gt;&lt;/font&gt;&lt;/b&gt;&quot;;
    } else {
        result = &quot;&lt;b&gt;&lt;font color=#ff0000&gt;No future fortune counter detected.&lt;br /&gt;&lt;/font&gt;&lt;/b&gt;&quot;;
    }
    result += &quot;&lt;b&gt;&lt;font color=#365f91&gt;Last semi-rare: &lt;font color=#00b0f0&gt;&quot; +
              get_property(&quot;semirareLocation&quot;) + &quot;&lt;/font&gt;&lt;/font&gt;&lt;/b&gt;&quot;;
    return result;
}</code></pre></article>
<article id="actual-11-5"><h2>ListItems <small>[11.5]</small></h2><p><code>string ListItems(int[item] Closet, int mode)</code></p><p>scripts/don_custom_functions.ash:159–175</p><p>function_actual11.5.2</p><pre><code>string ListItems(int[item] Closet, int mode) {
    string names = &quot;&quot;;
    foreach it in Closet {
        boolean include = false;
        switch (mode) {
            case 1: include = closet_amount(it) == 0; break;
            case 2: include = closet_amount(it) &gt; 0; break;
            case 3: include = item_amount(it) == 0; break;
            case 4: include = item_amount(it) &gt; 0; break;
            case 5: include = stash_amount(it) == 0; break;
            case 6: include = stash_amount(it) &gt; 0; break;
        }
        if (include) names = don_list_add(names, it.to_string());
    }
    if (names == &quot;&quot;) return &quot;&lt;EMPTY&gt;&quot;;
    return names;
}</code></pre></article>
<article id="actual-11-6"><h2>day_of_week <small>[11.6]</small></h2><p><code>int day_of_week()</code></p><p>scripts/don_custom_functions.ash:177–191</p><p>function_actual11.6.2</p><pre><code>int day_of_week() {
    // Use the date parser in don_master_lib rather than the old broken
    // yyyyMMdd slicing formula. 0 = Sunday, 6 = Saturday.
    string name = Day();
    switch (name) {
        case &quot;Sunday&quot;: return 0;
        case &quot;Monday&quot;: return 1;
        case &quot;Tuesday&quot;: return 2;
        case &quot;Wednesday&quot;: return 3;
        case &quot;Thursday&quot;: return 4;
        case &quot;Friday&quot;: return 5;
        case &quot;Saturday&quot;: return 6;
    }
    return -1;
}</code></pre></article>
<article id="actual-11-7"><h2>consume <small>[11.7]</small></h2><p><code>void consume()</code></p><p>scripts/don_custom_functions.ash:197–215</p><p>function_actual11.7.2</p><pre><code>void consume() {
    refresh_status();
    print(&quot;Fullness: &quot; + my_fullness() + &quot;/&quot; + fullness_limit());
    print(&quot;Inebriety: &quot; + my_inebriety() + &quot;/&quot; + inebriety_limit());
    print(&quot;Spleen: &quot; + my_spleen_use() + &quot;/&quot; + spleen_limit());

    int today = get_property(&quot;ascensionsToday&quot;).to_int();
    if (today == 0) {
        set_property(&quot;CONSUME.ALLOWLIFETIMELIMITED&quot;, &quot;true&quot;);
        set_property(&quot;valueOfAdventure&quot;, &quot;7100&quot;);
        if (!cli_execute(&quot;CONSUME ALL&quot;)) don_error(&quot;Leg 1 CONSUME failed.&quot;);
    } else if (today == 1) {
        set_property(&quot;CONSUME.ALLOWLIFETIMELIMITED&quot;, &quot;false&quot;);
        set_property(&quot;valueOfAdventure&quot;, &quot;6400&quot;);
        if (!cli_execute(&quot;CONSUME ALL&quot;)) don_error(&quot;Leg 2 CONSUME failed.&quot;);
    } else {
        don_warning(&quot;consume(): no rule for ascensionsToday=&quot; + today);
    }
}</code></pre></article>
<article id="actual-11-8"><h2>BeachAccess <small>[11.8]</small></h2><p><code>void BeachAccess()</code></p><p>scripts/don_custom_functions.ash:217–225</p><p>function_actual11.8.2</p><pre><code>void BeachAccess() {
    if (available_amount($item[134]) &gt; 0 ||
        available_amount($item[4770]) &gt; 0 ||
        available_amount($item[4769]) &gt; 0 ||
        available_amount($item[6775]) &gt; 0) return;

    if (!retrieve_item(1, $item[bitchin&#39; meatcar]))
        don_error(&quot;Unable to retrieve a bitchin&#39; meatcar for beach access.&quot;);
}</code></pre></article>
<article id="actual-11-9"><h2>advManager <small>[11.9]</small></h2><p><code>void advManager()</code></p><p>scripts/don_custom_functions.ash:227–233</p><p>function_actual11.9.2</p><pre><code>void advManager() {
    // Legacy branch that tried day-shorteners was unreachable; do not guess
    // at a spending policy in a library function.
    if (my_adventures() &gt; 50) abort(&quot;advManager(): more than 50 adventures.&quot;);
    if (my_adventures() &gt;= 5)
        don_warning(&quot;advManager(): no supported day-shortener action.&quot;);
}</code></pre></article>
<article id="actual-11-10"><h2>eat_sausage <small>[11.10]</small></h2><p><code>void eat_sausage()</code></p><p>scripts/don_custom_functions.ash:235–243</p><p>function_actual11.10.2</p><pre><code>void eat_sausage() {
    int needed = max(0, 23 - get_property(&quot;_sausagesEaten&quot;).to_int());
    if (needed &lt;= 0) {
        don_warning(&quot;No magical sausages remaining in configured daily target.&quot;);
        return;
    }
    if (!cli_execute(&quot;eat &quot; + needed + &quot; magical sausage&quot;))
        don_error(&quot;Unable to eat all configured magical sausages.&quot;);
}</code></pre></article>
<article id="actual-11-11"><h2>Sweat <small>[11.11]</small></h2><p><code>void Sweat()</code></p><p>scripts/don_custom_functions.ash:245–261</p><p>function_actual11.11.2</p><pre><code>void Sweat() {
    if (!have_skill($skill[Sweat Out Some Booze])) {
        don_warning(&quot;Sweat Out Some Booze not available.&quot;);
        return;
    }
    int attempts = 0;
    while (attempts &lt; 3 &amp;&amp;
           get_property(&quot;_sweatOutSomeBoozeUsed&quot;).to_int() &lt; 3 &amp;&amp;
           get_property(&quot;sweat&quot;).to_int() &gt;= 25 &amp;&amp;
           my_inebriety() &gt; 0) {
        attempts += 1;
        if (!use_skill(1, $skill[Sweat Out Some Booze])) {
            don_error(&quot;Sweat Out Some Booze failed; stopping.&quot;);
            return;
        }
    }
}</code></pre></article>
<article id="actual-11-12"><h2>startBarf <small>[11.12]</small></h2><p><code>void startBarf()</code></p><p>scripts/don_custom_functions.ash:263–275</p><p>function_actual11.12.2</p><pre><code>void startBarf() {
    int before = get_property(&quot;_juneCleaverEncounters&quot;).to_int();
    if (!cli_execute(&quot;barfascend.txt&quot;)) {
        don_error(&quot;barfascend.txt failed.&quot;);
        return;
    }
    if (get_property(&quot;_juneCleaverEncounters&quot;).to_int() != before) {
        don_warning(&quot;June Cleaver changed; retrying barfascend once.&quot;);
        cli_execute(&quot;uneffect beaten up&quot;);
        if (!cli_execute(&quot;barfascend.txt&quot;))
            don_error(&quot;barfascend.txt retry failed.&quot;);
    }
}</code></pre></article>
<article id="actual-11-13"><h2>comboAll <small>[11.13]</small></h2><p><code>void comboAll()</code></p><p>scripts/don_custom_functions.ash:277–284</p><p>function_actual11.13.2</p><pre><code>void comboAll() {
    int turns = my_adventures() - 1;
    if (turns &lt;= 0) {
        don_warning(&quot;comboAll(): no spare adventures.&quot;);
        return;
    }
    if (!cli_execute(&quot;combo &quot; + turns)) don_error(&quot;combo failed.&quot;);
}</code></pre></article>
<article id="actual-11-14"><h2>comb <small>[11.14]</small></h2><p><code>void comb()</code></p><p>scripts/don_custom_functions.ash:286–293</p><p>function_actual11.14.2</p><pre><code>void comb() {
    if (my_adventures() &lt; 1) use(1, $item[Law of Averages]);
    if (get_property(&quot;_freeBeachWalksUsed&quot;).to_int() != 11) {
        if (!cli_execute(&quot;combo.js&quot;)) don_error(&quot;combo.js failed.&quot;);
    } else {
        don_log(&quot;All configured free beach walks used.&quot;);
    }
}</code></pre></article>
<article id="actual-11-15"><h2>raffle <small>[11.15]</small></h2><p><code>void raffle()</code></p><p>scripts/don_custom_functions.ash:295–308</p><p>function_actual11.15.2</p><pre><code>void raffle() {
    int count = don_owned_amount($item[raffle ticket]);
    if (count &gt; 0) {
        don_log(&quot;Already holding &quot; + count + &quot; raffle tickets.&quot;);
        return;
    }
    if (!cli_execute(&quot;raffle 111&quot;)) {
        don_error(&quot;Raffle command failed.&quot;);
        return;
    }
    count = don_owned_amount($item[raffle ticket]);
    if (count &lt; 1) don_error(&quot;No raffle tickets acquired.&quot;);
    else don_good(&quot;Raffle tickets acquired: &quot; + count);
}</code></pre></article>
<article id="actual-11-16"><h2>autoBot <small>[11.16]</small></h2><p><code>void autoBot()</code></p><p>scripts/don_custom_functions.ash:310–322</p><p>function_actual11.16.2</p><pre><code>void autoBot() {
    if (get_property(&quot;_autumnatonQuests&quot;).to_int() != 0) return;
    location target = $location[none];
    foreach loc in $locations[The Deep Machine Tunnels, A Smoldering Pelvis, Shadow Rift] {
        if (can_adventure(loc)) target = loc;
    }
    if (target == $location[none]) {
        don_warning(&quot;No available autumn-aton destination.&quot;);
        return;
    }
    if (!cli_execute(&quot;autumnaton send &quot; + target))
        don_error(&quot;Could not send autumn-aton to &quot; + target);
}</code></pre></article>
<article id="actual-11-17"><h2>DOD <small>[11.17]</small></h2><p><code>void DOD()</code></p><p>scripts/don_custom_functions.ash:328–348</p><p>function_actual11.17.2</p><pre><code>void DOD() {
    if (my_meat() &lt; 5000) {
        don_error(&quot;At least 5000 meat required for DOD.&quot;);
        return;
    }
    if (available_amount($item[dead mimic]) &gt; 0) {
        don_good(&quot;Dead mimic acquired; ready to use.&quot;);
        return;
    }
    if (!can_adventure($location[The Dungeons of Doom])) {
        don_error(&quot;The Dungeons of Doom are not accessible.&quot;);
        return;
    }
    equip($slot[acc1], $item[none]);
    set_property(&quot;choiceAdventure25&quot;, &quot;2&quot;);
    while (item_amount($item[dead mimic]) == 0 &amp;&amp; my_adventures() &gt; 0) {
        if (!adventure(1, $location[The Dungeons of Doom])) break;
    }
    if (available_amount($item[dead mimic]) &gt; 0) don_good(&quot;Dead mimic acquired.&quot;);
    else don_error(&quot;Stopped without obtaining dead mimic.&quot;);
}</code></pre></article>
<article id="actual-11-18"><h2>EGTS <small>[11.18]</small></h2><p><code>void EGTS()</code></p><p>scripts/don_custom_functions.ash:350–398</p><p>function_actual11.18.2</p><pre><code>void EGTS() {
    string page = visit_url(&quot;da.php&quot;);
    if (contains_text(page, &quot;The Dungeons of Doom&quot;)) {
        DOD();
        return;
    }
    if (!can_adventure($location[The Enormous Greater-Than Sign])) {
        don_error(&quot;Greater-Than Sign is not accessible.&quot;);
        return;
    }
    set_property(&quot;choiceAdventure3&quot;, &quot;3&quot;);
    set_property(&quot;choiceAdventure451&quot;, &quot;3&quot;);
    while (available_amount($item[plus sign]) == 0 &amp;&amp; my_adventures() &gt; 0) {
        if (!adventure(1, $location[The Enormous Greater-Than Sign])) break;
    }
    if (available_amount($item[plus sign]) == 0) {
        don_error(&quot;Could not obtain a plus sign.&quot;);
        return;
    }
    set_property(&quot;choiceAdventure451&quot;, &quot;5&quot;);

    if (available_amount($item[ring of teleportation]) == 0 &amp;&amp;
        can_interact() &amp;&amp; my_meat() &gt; 100000)
        cli_execute(&quot;buy 1 ring of teleportation&quot;);

    if (available_amount($item[ring of teleportation]) == 0) {
        don_error(&quot;Ring of teleportation unavailable.&quot;);
        return;
    }

    item previous = equipped_item($slot[acc1]);
    if (!equip($slot[acc1], $item[ring of teleportation])) {
        don_error(&quot;Unable to equip teleportation ring.&quot;);
        return;
    }
    while (get_property(&quot;lastEncounter&quot;) != &quot;The Oracle Will See You Now&quot; &amp;&amp;
           my_adventures() &gt; 0) {
        if (!adventure(1, $location[The Enormous Greater-Than Sign])) break;
    }

    if (get_property(&quot;lastEncounter&quot;) != &quot;The Oracle Will See You Now&quot;) {
        don_error(&quot;Could not reach the Oracle.&quot;);
        equip($slot[acc1], previous);
        return;
    }
    if (!use(1, $item[plus sign])) don_error(&quot;Could not use plus sign.&quot;);
    equip($slot[acc1], previous);
    if (can_adventure($location[The Dungeons of Doom])) DOD();
}</code></pre></article>
<article id="actual-11-19"><h2>zapWand <small>[11.19]</small></h2><p><code>void zapWand()</code></p><p>scripts/don_custom_functions.ash:400–409</p><p>function_actual11.19.2</p><pre><code>void zapWand() {
    if (my_meat() &lt; 6000) {
        don_error(&quot;At least 6000 meat required for zap wand quest.&quot;);
        return;
    }
    string page = visit_url(&quot;da.php&quot;);
    if (contains_text(page, &quot;The Enormous Greater-Than Sign&quot;)) EGTS();
    else if (contains_text(page, &quot;The Dungeons of Doom&quot;)) DOD();
    else don_warning(&quot;Cannot determine dungeon access from da.php.&quot;);
}</code></pre></article>
<article id="actual-11-20"><h2>chowDown <small>[11.20]</small></h2><p><code>void chowDown()</code></p><p>scripts/don_custom_functions.ash:411–420</p><p>function_actual11.20.2</p><pre><code>void chowDown() {
    if (!outfit(&quot;chowDown&quot;)) {
        don_error(&quot;Missing chowDown outfit.&quot;);
        return;
    }
    cli_execute(&quot;refresh all&quot;);
    wait(5);
    consume();
    set_property(&quot;_don_chowdownCount&quot;, &quot;1&quot;);
}</code></pre></article>
<article id="actual-11-21"><h2>chowDown2 <small>[11.21]</small></h2><p><code>void chowDown2()</code></p><p>scripts/don_custom_functions.ash:422–431</p><p>function_actual11.21.2</p><pre><code>void chowDown2() {
    if (!outfit(&quot;chowDown2&quot;)) {
        don_error(&quot;Missing chowDown2 outfit.&quot;);
        return;
    }
    cli_execute(&quot;refresh all&quot;);
    wait(5);
    consume();
    set_property(&quot;_don_chowdownCount&quot;, &quot;2&quot;);
}</code></pre></article>
<article id="actual-11-22"><h2>openDungeon <small>[11.22]</small></h2><p><code>void openDungeon()</code></p><p>scripts/don_custom_functions.ash:433–443</p><p>function_actual11.22.2</p><pre><code>void openDungeon() {
    familiar yeti = $familiar[cooler yeti];
    int xp = yeti.experience;
    if (!outfit(&quot;yetibuff&quot;)) {
        don_error(&quot;Missing yetibuff outfit.&quot;);
        return;
    }
    don_log(&quot;Cooler Yeti: &quot; + xp + &quot;/400 XP.&quot;);
    if (xp &lt; 400 &amp;&amp; contains_text(visit_url(&quot;da.php&quot;), &quot;The Enormous Greater-Than Sign&quot;))
        zapWand();
}</code></pre></article>
<article id="actual-11-23"><h2>yetiAdv <small>[11.23]</small></h2><p><code>void yetiAdv()</code></p><p>scripts/don_custom_functions.ash:445–483</p><p>function_actual11.23.2</p><pre><code>void yetiAdv() {
    familiar yeti = $familiar[cooler yeti];
    if (!have_familiar(yeti)) {
        don_error(&quot;Cooler Yeti not owned.&quot;);
        return;
    }
    if (current_mcd() != 11) change_mcd(11);
    if (current_mcd() != 11) change_mcd(10);
    autoBot();
    if (!outfit(&quot;yetibuff&quot;)) {
        don_error(&quot;Missing yetibuff outfit.&quot;);
        return;
    }
    if (!use_familiar(yeti)) {
        don_error(&quot;Unable to equip Cooler Yeti.&quot;);
        return;
    }
    if (!cli_execute(&quot;CONSUME ALL VALUE 7500&quot;)) {
        don_error(&quot;CONSUME command failed.&quot;);
        return;
    }
    string dungeon = visit_url(&quot;da.php&quot;);
    if (contains_text(dungeon, &quot;The Enormous Greater-Than Sign&quot;)) {
        openDungeon();
    }
    if (!can_adventure($location[The Dungeons of Doom])) {
        don_error(&quot;Dungeons of Doom not accessible.&quot;);
        return;
    }
    while (my_adventures() &gt; 2 &amp;&amp; yeti.experience &lt; 400) {
        don_log(&quot;Cooler Yeti XP: &quot; + yeti.experience + &quot;/400.&quot;);
        if (!adventure(1, $location[The Dungeons of Doom])) {
            don_error(&quot;Adventure failed while training Yeti.&quot;);
            return;
        }
    }
    if (yeti.experience &gt;= 400) don_good(&quot;Cooler Yeti drink buff ready.&quot;);
    else don_warning(&quot;Cooler Yeti needs &quot; + max(0, 400 - yeti.experience) + &quot; XP.&quot;);
}</code></pre></article>
<article id="actual-11-24"><h2>stooperDis <small>[11.24]</small></h2><p><code>void stooperDis()</code></p><p>scripts/don_custom_functions.ash:489–502</p><p>function_actual11.24.2</p><pre><code>void stooperDis() {
    cli_execute(&quot;cast Communism!&quot;);
    familiar stooper = $familiar[Stooper];
    if (!have_familiar(stooper)) {
        don_warning(&quot;Stooper not available.&quot;);
        return;
    }
    if (!use_familiar(stooper)) return;
    if (my_inebriety() &lt; inebriety_limit() &amp;&amp;
        (available_amount($item[tiny stillsuit]) &gt; 0 ||
         have_equipped($item[tiny stillsuit]))) {
        cli_execute(&quot;drink stillsuit distillate&quot;);
    }
}</code></pre></article>
<article id="actual-11-25"><h2>don_get_cool <small>[11.25]</small></h2><p><code>boolean don_get_cool()</code></p><p>scripts/don_custom_functions.ash:505–554</p><p>function_actual11.25.2</p><pre><code>boolean don_get_cool() {
    if (!outfit(&quot;maxo&quot;)) {
        don_warning(&quot;getCool: missing maxo outfit.&quot;);
        return false;
    }
    refresh_status();
    if (!get_property(&quot;_communismUsed&quot;).to_boolean() &amp;&amp;
        my_inebriety() == inebriety_limit() - 1)
        stooperDis();

    familiar previous = my_familiar();
    familiar yeti = $familiar[cooler yeti];
    if (!have_familiar(yeti) || yeti.experience &lt; 400) {
        don_warning(&quot;Cooler Yeti missing or below 400 XP.&quot;);
        return false;
    }
    if (!use_familiar(yeti)) {
        don_error(&quot;Unable to equip Cooler Yeti.&quot;);
        return false;
    }
    if (!cli_execute(&quot;cast ode to booze&quot;)) {
        if (previous != $familiar[none]) use_familiar(previous);
        return false;
    }

    buffer page = visit_url(&quot;main.php?talktoyeti=1&quot;, false, true);
    buffer_to_file(page, &quot;_yeti_talk2.html&quot;);
    string[int] choices = available_choice_options();
    if (!handling_choice() || choices[2] == &quot;&quot;) {
        don_error(&quot;Cooler Yeti did not offer expected first option 2.&quot;);
        if (previous != $familiar[none]) use_familiar(previous);
        return false;
    }
    run_choice(2);
    choices = available_choice_options();
    if (!handling_choice() || choices[1] == &quot;&quot;) {
        don_error(&quot;Cooler Yeti did not offer expected follow-up option 1.&quot;);
        if (previous != $familiar[none]) use_familiar(previous);
        return false;
    }
    run_choice(1);
    if (handling_choice()) {
        don_error(&quot;Cooler Yeti follow-up choice remains open.&quot;);
        if (previous != $familiar[none]) use_familiar(previous);
        return false;
    }
    if (previous != $familiar[none]) use_familiar(previous);
    don_good(&quot;Yeti drink enhancement sequence submitted.&quot;);
    return true;
}</code></pre></article>
<article id="actual-11-26"><h2>getCool <small>[11.26]</small></h2><p><code>void getCool()</code></p><p>scripts/don_custom_functions.ash:557–557</p><p>function_actual11.26.2</p><pre><code>void getCool() { don_get_cool(); }</code></pre></article>
<article id="actual-11-27"><h2>get_cool <small>[11.27]</small></h2><p><code>void get_cool()</code></p><p>scripts/don_custom_functions.ash:558–558</p><p>function_actual11.27.2</p><pre><code>void get_cool() { don_get_cool(); }</code></pre></article>
<article id="actual-11-28"><h2>shrugAT <small>[11.28]</small></h2><p><code>void shrugAT()</code></p><p>scripts/don_custom_functions.ash:561–569</p><p>function_actual11.28.2</p><pre><code>void shrugAT() {
    cli_execute(&quot;shrug Stevedave&#39;s Shanty of Superiority&quot;);
    cli_execute(&quot;shrug Power Ballad of the Arrowsmith&quot;);
    cli_execute(&quot;shrug The Moxious Madrigal&quot;);
    cli_execute(&quot;shrug The Magical Mojomuscular Melody&quot;);
    cli_execute(&quot;shrug Cletus&#39;s Canticle of Celerity&quot;);
    cli_execute(&quot;shrug Jackasses&#39; Symphony of Destruction&quot;);
    cli_execute(&quot;shrug Brawnee&#39;s Anthem of Absorption&quot;);
}</code></pre></article>
<article id="actual-11-29"><h2>don_mayam <small>[11.29]</small></h2><p><code>void don_mayam()</code></p><p>scripts/don_custom_functions.ash:571–597</p><p>function_actual11.29.2</p><pre><code>void don_mayam() {
    if (available_amount($item[Mayam Calendar]) == 0 ||
        get_property(&quot;_don_mayam_done&quot;).to_boolean()) return;

    familiar mimic = $familiar[chest mimic];
    if (!have_familiar(mimic)) {
        don_warning(&quot;Chest Mimic not available; skipping Mayam.&quot;);
        return;
    }
    familiar previous = my_familiar();
    if (!use_familiar(mimic)) {
        don_error(&quot;Cannot equip Chest Mimic.&quot;);
        return;
    }
    boolean ok1 = cli_execute(&quot;mayam rings fur meat eyepatch yam&quot;);
    boolean ok2 = cli_execute(&quot;mayam rings yam lightning yam clock&quot;);
    boolean ok3 = cli_execute(&quot;mayam rings vessel yam cheese explosion&quot;);
    if (previous != $familiar[none]) use_familiar(previous);

    if (ok1 &amp;&amp; ok2 &amp;&amp; ok3) {
        set_property(&quot;_don_mayam_done&quot;, &quot;true&quot;);
        used_don_mayam = true;
        don_good(&quot;Mayam commands completed.&quot;);
    } else {
        don_error(&quot;Mayam command failed; completion pref unchanged.&quot;);
    }
}</code></pre></article>
<article id="actual-11-30"><h2>cockroach_fight_prep <small>[11.30]</small></h2><p><code>boolean cockroach_fight_prep()</code></p><p>scripts/don_custom_functions.ash:602–620</p><p>function_actual11.30.2</p><pre><code>boolean cockroach_fight_prep() {
    if (get_property(&quot;_lastPirateRealmIsland&quot;) == &quot;Trash Island&quot;) {
        don_log(&quot;PirateRealm already points to Trash Island.&quot;);
        return true;
    }
    if (my_inebriety() &gt; inebriety_limit()) {
        don_warning(&quot;Cockroach prep skipped: character is overdrunk.&quot;);
        return false;
    }
    set_property(&quot;_don_cockroachRouteResult&quot;, &quot;not-run&quot;);
    if (!cli_execute(&quot;call don_cockroach_router.ash&quot;)) {
        don_warning(&quot;Cockroach router failed or is unavailable.&quot;);
        return false;
    }
    boolean done = get_property(&quot;_don_cockroachRouteResult&quot;) == &quot;success&quot; &amp;&amp;
                   get_property(&quot;_lastPirateRealmIsland&quot;) == &quot;Trash Island&quot;;
    if (!done) don_warning(&quot;Cockroach preparation incomplete; review router logs.&quot;);
    return done;
}</code></pre></article>
<article id="actual-11-31"><h2>don_breakfast_is_pastamancer <small>[11.31]</small></h2><p><code>boolean don_breakfast_is_pastamancer(class character_class)</code></p><p>scripts/don_custom_functions.ash:625–627</p><p>function_actual11.31.2</p><pre><code>boolean don_breakfast_is_pastamancer(class character_class) {
    return character_class == $class[Pastamancer];
}</code></pre></article>
<article id="actual-11-32"><h2>don_breakfast_combo_turns <small>[11.32]</small></h2><p><code>int don_breakfast_combo_turns(int adventures_available)</code></p><p>scripts/don_custom_functions.ash:629–632</p><p>function_actual11.32.2</p><pre><code>int don_breakfast_combo_turns(int adventures_available) {
    if (adventures_available &lt;= 15) return 0;
    return adventures_available - 15;
}</code></pre></article>
<article id="actual-11-33"><h2>don_breakfast_legacy_preference <small>[11.33]</small></h2><p><code>string don_breakfast_legacy_preference(string canonical)</code></p><p>scripts/don_custom_functions.ash:636–643</p><p>function_actual11.33.2</p><pre><code>string don_breakfast_legacy_preference(string canonical) {
    if (canonical == &quot;don_breakfast_barf&quot;) return &quot;donBreakfastBarf&quot;;
    if (canonical == &quot;don_breakfast_nobarf&quot;) return &quot;donBreakfastNobarf&quot;;
    if (canonical == &quot;don_breakfast_cowo&quot;) return &quot;donBreakfastCowo&quot;;
    if (canonical == &quot;don_breakfast_nobarf_combo&quot;) return &quot;donBreakfastNobarfCombo&quot;;
    if (canonical == &quot;don_breakfast_cockroach&quot;) return &quot;don_breakfastCockroach&quot;;
    return &quot;&quot;;
}</code></pre></article>
<article id="actual-11-34"><h2>don_breakfast_preference_enabled <small>[11.34]</small></h2><p><code>boolean don_breakfast_preference_enabled(string canonical)</code></p><p>scripts/don_custom_functions.ash:645–652</p><p>function_actual11.34.2</p><pre><code>boolean don_breakfast_preference_enabled(string canonical) {
    string saved_value = get_property(canonical);
    if (saved_value == &quot;&quot;) {
        string legacy_name = don_breakfast_legacy_preference(canonical);
        if (legacy_name != &quot;&quot;) saved_value = get_property(legacy_name);
    }
    return saved_value.to_boolean();
}</code></pre></article>
<article id="actual-11-35"><h2>don_breakfast_migrate_one <small>[11.35]</small></h2><p><code>void don_breakfast_migrate_one(string canonical)</code></p><p>scripts/don_custom_functions.ash:654–661</p><p>function_actual11.35.2</p><pre><code>void don_breakfast_migrate_one(string canonical) {
    if (get_property(canonical) != &quot;&quot;) return;
    string legacy_name = don_breakfast_legacy_preference(canonical);
    if (legacy_name == &quot;&quot;) return;
    string legacy_value = get_property(legacy_name);
    if (legacy_value == &quot;&quot;) return;
    set_property(canonical, legacy_value.to_boolean() ? &quot;true&quot; : &quot;false&quot;);
}</code></pre></article>
<article id="actual-11-36"><h2>don_breakfast_migrate_preferences <small>[11.36]</small></h2><p><code>void don_breakfast_migrate_preferences()</code></p><p>scripts/don_custom_functions.ash:663–669</p><p>function_actual11.36.2</p><pre><code>void don_breakfast_migrate_preferences() {
    don_breakfast_migrate_one(&quot;don_breakfast_barf&quot;);
    don_breakfast_migrate_one(&quot;don_breakfast_nobarf&quot;);
    don_breakfast_migrate_one(&quot;don_breakfast_cowo&quot;);
    don_breakfast_migrate_one(&quot;don_breakfast_nobarf_combo&quot;);
    don_breakfast_migrate_one(&quot;don_breakfast_cockroach&quot;);
}</code></pre></article>
<article id="actual-11-37"><h2>don_breakfast_active_modes <small>[11.37]</small></h2><p><code>int don_breakfast_active_modes()</code></p><p>scripts/don_custom_functions.ash:671–678</p><p>function_actual11.37.2</p><pre><code>int don_breakfast_active_modes() {
    int active = 0;
    if (get_property(&quot;don_breakfast_barf&quot;).to_boolean()) active += 1;
    if (get_property(&quot;don_breakfast_nobarf&quot;).to_boolean()) active += 1;
    if (get_property(&quot;don_breakfast_cowo&quot;).to_boolean()) active += 1;
    if (get_property(&quot;don_breakfast_nobarf_combo&quot;).to_boolean()) active += 1;
    return active;
}</code></pre></article>
<article id="actual-11-38"><h2>don_breakfast_mode_preference <small>[11.38]</small></h2><p><code>string don_breakfast_mode_preference(string mode_name)</code></p><p>scripts/don_custom_functions.ash:680–689</p><p>function_actual11.38.2</p><pre><code>string don_breakfast_mode_preference(string mode_name) {
    if (mode_name == &quot;barf&quot;) return &quot;don_breakfast_barf&quot;;
    if (mode_name == &quot;nobarf&quot;) return &quot;don_breakfast_nobarf&quot;;
    if (mode_name == &quot;cowo&quot;) return &quot;don_breakfast_cowo&quot;;
    if (mode_name == &quot;nobarfcombo&quot; || mode_name == &quot;nobarf-combo&quot;)
        return &quot;don_breakfast_nobarf_combo&quot;;
    if (mode_name == &quot;cockroach&quot; || mode_name == &quot;roaches&quot;)
        return &quot;don_breakfast_cockroach&quot;;
    return &quot;&quot;;
}</code></pre></article>
<article id="actual-11-39"><h2>don_breakfast_set_mode <small>[11.39]</small></h2><p><code>boolean don_breakfast_set_mode(string mode_name, boolean enabled)</code></p><p>scripts/don_custom_functions.ash:692–729</p><p>function_actual11.39.2</p><pre><code>boolean don_breakfast_set_mode(string mode_name, boolean enabled) {
    string preference_name = don_breakfast_mode_preference(mode_name);
    if (preference_name == &quot;&quot;) {
        don_warning(&quot;Unknown breakfast mode: &quot; + mode_name);
        return false;
    }

    don_breakfast_migrate_preferences();

    if (preference_name == &quot;don_breakfast_cockroach&quot;) {
        if (!enabled &amp;&amp; don_breakfast_active_modes() &gt; 0) {
            don_warning(&quot;Cannot turn off cockroach prep while a farming mode is enabled.&quot;);
            return false;
        }
        set_property(preference_name, enabled ? &quot;true&quot; : &quot;false&quot;);
        return true;
    }

    if (enabled &amp;&amp; preference_name == &quot;don_breakfast_cowo&quot; &amp;&amp;
        !don_breakfast_is_pastamancer(my_class())) {
        set_property(&quot;don_breakfast_cowo&quot;, &quot;false&quot;);
        don_warning(&quot;Cowo requires Pastamancer. don_breakfast_cowo reset to false.&quot;);
        return false;
    }

    if (enabled) {
        // Only one farming mode may be active. Roach preparation is required.
        set_property(&quot;don_breakfast_barf&quot;, &quot;false&quot;);
        set_property(&quot;don_breakfast_nobarf&quot;, &quot;false&quot;);
        set_property(&quot;don_breakfast_cowo&quot;, &quot;false&quot;);
        set_property(&quot;don_breakfast_nobarf_combo&quot;, &quot;false&quot;);
        set_property(preference_name, &quot;true&quot;);
        set_property(&quot;don_breakfast_cockroach&quot;, &quot;true&quot;);
    } else {
        set_property(preference_name, &quot;false&quot;);
    }
    return true;
}</code></pre></article>
<article id="actual-11-40"><h2>don_breakfast_help <small>[11.40]</small></h2><p><code>void don_breakfast_help()</code></p><p>scripts/don_custom_functions.ash:732–752</p><p>function_actual11.40.2</p><pre><code>void don_breakfast_help() {
    don_header(&quot;donBreakfast preferences&quot;);
    print(&quot;don_breakfast_barf = &quot; + don_breakfast_preference_enabled(&quot;don_breakfast_barf&quot;));
    print(&quot;don_breakfast_nobarf = &quot; + don_breakfast_preference_enabled(&quot;don_breakfast_nobarf&quot;));
    print(&quot;don_breakfast_cowo = &quot; + don_breakfast_preference_enabled(&quot;don_breakfast_cowo&quot;) +
          &quot; (Pastamancer only; eligible: &quot; +
          don_breakfast_is_pastamancer(my_class()) + &quot;)&quot;);
    print(&quot;don_breakfast_nobarf_combo = &quot; +
          don_breakfast_preference_enabled(&quot;don_breakfast_nobarf_combo&quot;) +
          &quot; (nobarf, refresh all, combo with 15 adventures reserved)&quot;);
    print(&quot;don_breakfast_cockroach = &quot; +
          don_breakfast_preference_enabled(&quot;don_breakfast_cockroach&quot;) +
          &quot; (required for every farming mode)&quot;);
    print(&quot;All modes default to false when their preference is unset.&quot;);
    print(&quot;Old preference values appear until migrated during mode changes or run.&quot;);
    print(&quot;donBreakfast help | status | run&quot;);
    print(&quot;donBreakfast barf|nobarf|cowo|nobarfcombo on|off&quot;);
    print(&quot;donBreakfast cockroach on|off&quot;);
    print(&quot;Using &#39;on&#39; disables competing farming modes and enables cockroach prep.&quot;);
    print(&quot;Direct CLI &#39;set&#39; changes are validated when breakfast runs.&quot;);
}</code></pre></article>
<article id="actual-11-41"><h2>don_breakfast_validate_modes <small>[11.41]</small></h2><p><code>boolean don_breakfast_validate_modes()</code></p><p>scripts/don_custom_functions.ash:756–773</p><p>function_actual11.41.2</p><pre><code>boolean don_breakfast_validate_modes() {
    don_breakfast_migrate_preferences();
    if (get_property(&quot;don_breakfast_cowo&quot;).to_boolean() &amp;&amp;
        !don_breakfast_is_pastamancer(my_class())) {
        set_property(&quot;don_breakfast_cowo&quot;, &quot;false&quot;);
        don_warning(&quot;Non-Pastamancer: don_breakfast_cowo reset to false.&quot;);
    }
    int active = don_breakfast_active_modes();
    if (active &gt; 1) {
        don_error(&quot;Conflicting breakfast modes: no farming will run. Use donBreakfast &lt;mode&gt; on or turn the unwanted preferences off.&quot;);
        return false;
    }
    if (active == 1 &amp;&amp; !get_property(&quot;don_breakfast_cockroach&quot;).to_boolean()) {
        set_property(&quot;don_breakfast_cockroach&quot;, &quot;true&quot;);
        don_log(&quot;Enabled cockroach prep for the active breakfast farming mode.&quot;);
    }
    return true;
}</code></pre></article>
<article id="actual-11-42"><h2>don_breakfast_run_farming_mode <small>[11.42]</small></h2><p><code>void don_breakfast_run_farming_mode()</code></p><p>scripts/don_custom_functions.ash:775–811</p><p>function_actual11.42.2</p><pre><code>void don_breakfast_run_farming_mode() {
    if (get_property(&quot;don_breakfast_cowo&quot;).to_boolean()) {
        if (!don_breakfast_is_pastamancer(my_class())) {
            set_property(&quot;don_breakfast_cowo&quot;, &quot;false&quot;);
            don_warning(&quot;Cowo skipped: only Pastamancers may enable it.&quot;);
            return;
        }
        if (!cli_execute(&quot;cowo&quot;)) don_error(&quot;cowo CLI command failed.&quot;);
        return;
    }

    if (get_property(&quot;don_breakfast_nobarf_combo&quot;).to_boolean()) {
        if (!cli_execute(&quot;nobarf&quot;)) {
            don_error(&quot;nobarf failed. Skipping refresh and combo.&quot;);
            return;
        }
        if (!cli_execute(&quot;refresh all&quot;)) {
            don_error(&quot;refresh all failed. Skipping combo.&quot;);
            return;
        }
        int combo_turns = don_breakfast_combo_turns(my_adventures());
        if (combo_turns == 0) {
            don_log(&quot;nobarf finished; 15-adventure reserve leaves no combo turns.&quot;);
            return;
        }
        if (!cli_execute(&quot;combo &quot; + combo_turns))
            don_error(&quot;combo failed after nobarf and refresh.&quot;);
        return;
    }

    if (get_property(&quot;don_breakfast_nobarf&quot;).to_boolean()) {
        if (!cli_execute(&quot;nobarf&quot;)) don_error(&quot;nobarf CLI command failed.&quot;);
        return;
    }
    if (get_property(&quot;don_breakfast_barf&quot;).to_boolean() &amp;&amp;
        !cli_execute(&quot;barf&quot;)) don_error(&quot;barf CLI command failed.&quot;);
}</code></pre></article>
<article id="actual-11-43"><h2>don_breakfast_prepare_daily <small>[11.43]</small></h2><p><code>boolean don_breakfast_prepare_daily()</code></p><p>scripts/don_custom_functions.ash:815–834</p><p>function_actual11.43.2</p><pre><code>boolean don_breakfast_prepare_daily() {
    if (!don_breakfast_validate_modes()) return false;
    if (!get_property(&quot;breakfastCompleted&quot;).to_boolean()) {
        if (!cli_execute(&quot;breakfast&quot;)) return false;
    } else don_log(&quot;Native breakfast already completed; checking Don daily tasks.&quot;);
    raffle();
    if (!get_property(&quot;_aprilShower&quot;).to_boolean() &amp;&amp;
        !cli_execute(&quot;shower ice&quot;)) don_warning(&quot;Shower ice command failed.&quot;);
    if (get_property(&quot;bankedKarma&quot;).to_int() &gt; 2000 &amp;&amp;
        available_amount($item[The Big Book of Every Skill]) &gt; 0 &amp;&amp;
        !use(1, $item[The Big Book of Every Skill]))
        don_warning(&quot;Could not use Big Book of Every Skill.&quot;);
    don_mayam();
    if (get_property(&quot;don_breakfast_cockroach&quot;).to_boolean() &amp;&amp;
        !cockroach_fight_prep()) {
        don_warning(&quot;Cockroach route failed; stopping before farming.&quot;);
        return false;
    }
    return true;
}</code></pre></article>
<article id="actual-11-44"><h2>augmentBreakfast <small>[11.44]</small></h2><p><code>void augmentBreakfast()</code></p><p>scripts/don_custom_functions.ash:836–839</p><p>function_actual11.44.2</p><pre><code>void augmentBreakfast() {
    if (!don_breakfast_prepare_daily()) return;
    don_breakfast_run_farming_mode();
}</code></pre></article>
<article id="actual-11-45"><h2>Baseline <small>[11.45]</small></h2><p><code>void Baseline()</code></p><p>scripts/don_custom_functions.ash:841–857</p><p>function_actual11.45.2</p><pre><code>void Baseline() {
    shrugAT();
    cli_execute(&quot;hagnk all&quot;);
    cli_execute(&quot;refresh all&quot;);
    cli_execute(&quot;mood apathetic&quot;);
    cli_execute(&quot;ccs don_default&quot;);
    set_property(&quot;hpAutoRecovery&quot;, &quot;0.65&quot;);
    set_property(&quot;hpAutoRecoveryTarget&quot;, &quot;0.95&quot;);
    set_property(&quot;mpAutoRecovery&quot;, &quot;0.65&quot;);
    set_property(&quot;mpAutoRecoveryTarget&quot;, &quot;0.95&quot;);
    effect sparky = $effect[1927];
    item antidote = $item[Soft green echo eyedrop antidote];
    if (have_effect(sparky) &gt; 0) {
        if (item_amount(antidote) &lt; 1) buy(1, antidote);
        cli_execute(&quot;uneffect &quot; + sparky);
    }
}</code></pre></article>
<article id="actual-11-46"><h2>don_nightcap_configured_id <small>[11.46]</small></h2><p><code>int don_nightcap_configured_id(string preference_name)</code></p><p>scripts/don_custom_functions.ash:861–865</p><p>function_actual11.46.2</p><pre><code>int don_nightcap_configured_id(string preference_name) {
    int chosen_id = get_property(preference_name).to_int();
    if (chosen_id &lt;= 0) return 5227;
    return chosen_id;
}</code></pre></article>
<article id="actual-11-47"><h2>don_nightcap_price_limit <small>[11.47]</small></h2><p><code>int don_nightcap_price_limit()</code></p><p>scripts/don_custom_functions.ash:867–870</p><p>function_actual11.47.2</p><pre><code>int don_nightcap_price_limit() {
    int stored = get_property(&quot;don_nightcap_buy_limit&quot;).to_int();
    return stored &gt; 0 ? stored : 175000;
}</code></pre></article>
<article id="actual-11-48"><h2>don_nightcap_pick <small>[11.48]</small></h2><p><code>item don_nightcap_pick()</code></p><p>scripts/don_custom_functions.ash:872–896</p><p>function_actual11.48.2</p><pre><code>item don_nightcap_pick() {
    string selector = get_property(&quot;don_event&quot;);
    if (!selector.to_boolean())
        return to_item(don_nightcap_configured_id(&quot;don_defaultNightcap&quot;));

    item first = to_item(8553);
    item second = to_item(8554);
    int price_first = first == $item[none] ? 0 : mall_price(first);
    int price_second = second == $item[none] ? 0 : mall_price(second);
    int limit_price = don_nightcap_price_limit();

    // Owned items have no new purchase cost; prefer them before mall shopping.
    if (first != $item[none] &amp;&amp; (item_amount(first) &gt; 0 || closet_amount(first) &gt; 0))
        return first;
    if (second != $item[none] &amp;&amp; (item_amount(second) &gt; 0 || closet_amount(second) &gt; 0))
        return second;

    if (price_first &gt; 0 &amp;&amp; price_first &lt;= limit_price &amp;&amp;
        (price_second &lt;= 0 || price_first &lt;= price_second))
        return first;
    if (price_second &gt; 0 &amp;&amp; price_second &lt;= limit_price) return second;

    don_warning(&quot;Neither event item 8553 nor 8554 has an acceptable mall estimate; using don_eventNightcap fallback.&quot;);
    return to_item(don_nightcap_configured_id(&quot;don_eventNightcap&quot;));
}</code></pre></article>
<article id="actual-11-49"><h2>don_nightcap <small>[11.49]</small></h2><p><code>boolean don_nightcap()</code></p><p>scripts/don_custom_functions.ash:898–933</p><p>function_actual11.49.2</p><pre><code>boolean don_nightcap() {
    if (my_inebriety() &gt; inebriety_limit()) {
        don_log(&quot;Already overdrunk: will not consume a second nightcap.&quot;);
        return true;
    }
    item selected = don_nightcap_pick();
    if (selected == $item[none]) {
        don_error(&quot;Configured nightcap item ID is invalid.&quot;);
        return false;
    }
    int cap = don_nightcap_price_limit();
    don_log(&quot;Nightcap selection: &quot; + selected + &quot; (item &quot; + selected.id + &quot;; buy limit &quot; + cap + &quot;).&quot;);
    if (item_amount(selected) &lt; 1 &amp;&amp; closet_amount(selected) &gt; 0 &amp;&amp;
        !take_closet(1, selected)) {
        don_error(&quot;Could not retrieve nightcap from closet.&quot;);
        return false;
    }
    if (item_amount(selected) &lt; 1) {
        int estimate = mall_price(selected);
        if (estimate &lt;= 0 || estimate &gt; cap) {
            don_error(&quot;Nightcap mall estimate unavailable or above cap: &quot; + estimate);
            return false;
        }
        if (buy(1, selected, cap) &lt; 1) {
            don_error(&quot;Could not buy nightcap within configured cap.&quot;);
            return false;
        }
    }
    int before_inebriety = my_inebriety();
    if (!overdrink(1, selected) || my_inebriety() &lt;= before_inebriety) {
        don_error(&quot;Nightcap did not increase inebriety.&quot;);
        return false;
    }
    don_good(&quot;Nightcap completed: &quot; + selected + &quot;.&quot;);
    return true;
}</code></pre></article>
<article id="actual-11-50"><h2>nightcap <small>[11.50]</small></h2><p><code>void nightcap()</code></p><p>scripts/don_custom_functions.ash:935–935</p><p>function_actual11.50.2</p><pre><code>void nightcap() { don_nightcap(); }</code></pre></article>
<article id="actual-11-51"><h2>don_dpills <small>[11.51]</small></h2><p><code>void don_dpills()</code></p><p>scripts/don_custom_functions.ash:938–947</p><p>function_actual11.51.2</p><pre><code>void don_dpills() {
    cli_execute(&quot;ccs don_default&quot;);
    cli_execute(&quot;outfit wineglass&quot;);
    cli_execute(&quot;mood apathetic&quot;);
    if (!cli_execute(&quot;dpills &quot; + my_adventures())) {
        don_error(&quot;dpills command failed.&quot;);
        return;
    }
    set_property(&quot;_don_dailyPills&quot;, my_adventures() &lt; 5 ? &quot;true&quot; : &quot;false&quot;);
}</code></pre></article>
<article id="actual-11-52"><h2>don_Midcap <small>[11.52]</small></h2><p><code>void don_Midcap()</code></p><p>scripts/don_custom_functions.ash:949–965</p><p>function_actual11.52.2</p><pre><code>void don_Midcap() {
    item midcap = $item[bucket of wine];
    if (needToAcquireItem(midcap)) buy(1, midcap, 15000);
    if (available_amount(midcap) == 0) {
        don_error(&quot;Bucket of wine unavailable within 15000 meat limit.&quot;);
        return;
    }
    familiar stooper = $familiar[Stooper];
    if (!have_familiar(stooper)) {
        don_warning(&quot;Stooper unavailable; not overdrinking.&quot;);
        return;
    }
    familiar previous = my_familiar();
    if (!use_familiar(stooper)) return;
    if (!overdrink(1, midcap)) don_error(&quot;Overdrink failed.&quot;);
    if (previous != $familiar[none]) use_familiar(previous);
}</code></pre></article>
<article id="actual-11-53"><h2>don_Midcap_Pills <small>[11.53]</small></h2><p><code>void don_Midcap_Pills()</code></p><p>scripts/don_custom_functions.ash:967–976</p><p>function_actual11.53.2</p><pre><code>void don_Midcap_Pills() {
    if (!don_is_overdrunk() &amp;&amp; my_adventures() &gt;= 50) {
        int spare = my_adventures() - 50;
        if (spare &gt; 0 &amp;&amp; !cli_execute(&quot;combo &quot; + spare)) {
            don_error(&quot;combo failed; not launching dpills.&quot;);
            return;
        }
    }
    don_dpills();
}</code></pre></article>
<article id="actual-11-54"><h2>newstuff <small>[11.54]</small></h2><p><code>void newstuff()</code></p><p>scripts/don_custom_functions.ash:978–1004</p><p>function_actual11.54.2</p><pre><code>void newstuff() {
    int profitOffset = 100;
    string page = visit_url(&quot;campground.php?action=inspectdwelling&quot;);
    if (contains_text(page, &quot;Clockwork Maid&quot;) ||
        contains_text(page, &quot;Meat Butler&quot;) ||
        contains_text(page, &quot;Meat Maid&quot;)) {
        don_log(&quot;Maid or butler already installed.&quot;);
        return;
    }
    int voa = get_property(&quot;valueOfAdventure&quot;).to_int();
    if (available_amount($item[Clockwork Maid]) &gt; 0 ||
        buy(1, $item[Clockwork Maid], max(0, 8 * voa - profitOffset)) == 1) {
        if (!use(1, $item[Clockwork Maid])) don_error(&quot;Clockwork Maid install failed.&quot;);
        return;
    }
    if (available_amount($item[Meat Butler]) &gt; 0 ||
        buy(1, $item[Meat Butler], max(0, 4 * voa - profitOffset)) == 1) {
        if (!use(1, $item[Meat Butler])) don_error(&quot;Meat Butler install failed.&quot;);
        return;
    }
    if (available_amount($item[Meat Maid]) &gt; 0 ||
        buy(1, $item[Meat Maid], max(0, 4 * voa - profitOffset)) == 1) {
        if (!use(1, $item[Meat Maid])) don_error(&quot;Meat Maid install failed.&quot;);
        return;
    }
    don_warning(&quot;Maid / butler options are all outside price range.&quot;);
}</code></pre></article>
<article id="actual-11-55"><h2>don_post_run_sync_date <small>[11.55]</small></h2><p><code>void don_post_run_sync_date()</code></p><p>scripts/don_custom_functions.ash:1012–1018</p><p>function_actual11.55.2</p><pre><code>void don_post_run_sync_date() {
    string today = today_to_string();
    if (get_property(&quot;don_post_run_date&quot;) == today) return;
    set_property(&quot;don_post_run_date&quot;, today);
    set_property(&quot;don_post_run_stage&quot;, &quot;new&quot;);
    set_property(&quot;don_post_run_eod_step&quot;, &quot;0&quot;);
}</code></pre></article>
<article id="actual-11-56"><h2>don_post_run_step_done <small>[11.56]</small></h2><p><code>boolean don_post_run_step_done(string step_name)</code></p><p>scripts/don_custom_functions.ash:1020–1022</p><p>function_actual11.56.2</p><pre><code>boolean don_post_run_step_done(string step_name) {
    return get_property(&quot;don_post_run_stage&quot;) == step_name;
}</code></pre></article>
<article id="actual-11-57"><h2>don_post_run_track <small>[11.57]</small></h2><p><code>void don_post_run_track(string label)</code></p><p>scripts/don_custom_functions.ash:1024–1029</p><p>function_actual11.57.2</p><pre><code>void don_post_run_track(string label) {
    // Optional, non-authoritative telemetry; never a required import.
    if (!get_property(&quot;don_post_run_ptrack&quot;).to_boolean()) return;
    if (!cli_execute(&quot;call ptrack.ash add &quot; + label))
        don_warning(&quot;ptrack checkpoint unavailable: &quot; + label);
}</code></pre></article>
<article id="actual-11-58"><h2>don_post_run_status <small>[11.58]</small></h2><p><code>void don_post_run_status()</code></p><p>scripts/don_custom_functions.ash:1031–1048</p><p>function_actual11.58.2</p><pre><code>void don_post_run_status() {
    print(&quot;don_post_run_date = &quot; + get_property(&quot;don_post_run_date&quot;));
    print(&quot;don_post_run_stage = &quot; + get_property(&quot;don_post_run_stage&quot;));
    print(&quot;don_post_run_eod_step = &quot; + get_property(&quot;don_post_run_eod_step&quot;));
    print(&quot;don_defaultNightcap = &quot; + don_nightcap_configured_id(&quot;don_defaultNightcap&quot;) +
          &quot; (&quot; + to_item(don_nightcap_configured_id(&quot;don_defaultNightcap&quot;)) + &quot;)&quot;);
    print(&quot;don_event = &quot; + get_property(&quot;don_event&quot;).to_boolean());
    print(&quot;don_eventNightcap = &quot; + don_nightcap_configured_id(&quot;don_eventNightcap&quot;) +
          &quot; (&quot; + to_item(don_nightcap_configured_id(&quot;don_eventNightcap&quot;)) + &quot;)&quot;);
    print(&quot;don_nightcap_buy_limit = &quot; + don_nightcap_price_limit());
    print(&quot;don_post_run_philter = &quot; + get_property(&quot;don_post_run_philter&quot;).to_boolean());
    print(&quot;don_post_run_ptrack = &quot; + get_property(&quot;don_post_run_ptrack&quot;).to_boolean());
    print(&quot;Yeti XP = &quot; + $familiar[cooler yeti].experience + &quot;/400&quot;);
    print(&quot;Adventures = &quot; + my_adventures());
    print(&quot;Fullness = &quot; + my_fullness() + &quot;/&quot; + fullness_limit() +
          &quot;; spleen = &quot; + my_spleen_use() + &quot;/&quot; + spleen_limit() +
          &quot;; inebriety = &quot; + my_inebriety() + &quot;/&quot; + inebriety_limit());
}</code></pre></article>
<article id="actual-11-59"><h2>don_post_run_prepare <small>[11.59]</small></h2><p><code>boolean don_post_run_prepare()</code></p><p>scripts/don_custom_functions.ash:1050–1072</p><p>function_actual11.59.2</p><pre><code>boolean don_post_run_prepare() {
    don_post_run_sync_date();
    if (!get_property(&quot;_don_famMax&quot;).to_boolean() &amp;&amp;
        my_inebriety() &lt;= inebriety_limit()) {
        if (!cli_execute(&quot;maximize familiar exp&quot;)) {
            don_error(&quot;Familiar experience maximizer failed.&quot;);
            return false;
        }
        set_property(&quot;_don_famMax&quot;, &quot;true&quot;);
    }
    if (!outfit(&quot;maxorgan&quot;)) {
        don_error(&quot;Missing required maxorgan outfit.&quot;);
        return false;
    }
    stooperDis();
    if (!cli_execute(&quot;CONSUME ALL VALUE 6500&quot;)) {
        don_error(&quot;CONSUME ALL VALUE 6500 failed.&quot;);
        return false;
    }
    set_property(&quot;don_post_run_stage&quot;, &quot;prepared&quot;);
    don_post_run_track(&quot;postrun_prepared&quot;);
    return true;
}</code></pre></article>
<article id="actual-11-60"><h2>don_post_run_yeti_stage <small>[11.60]</small></h2><p><code>boolean don_post_run_yeti_stage()</code></p><p>scripts/don_custom_functions.ash:1075–1132</p><p>function_actual11.60.2</p><pre><code>boolean don_post_run_yeti_stage() {
    don_post_run_sync_date();
    familiar yeti = $familiar[cooler yeti];
    if (!have_familiar(yeti)) {
        don_error(&quot;No Cooler Yeti owned.&quot;);
        return false;
    }
    don_log(&quot;Cooler Yeti XP: &quot; + yeti.experience + &quot;/400.&quot;);
    if (yeti.experience &gt;= 400) {
        set_property(&quot;don_post_run_stage&quot;, &quot;yeti_ready&quot;);
        return true;
    }
    if (my_adventures() &lt;= 20) {
        don_warning(&quot;Yeti is below 400 XP and no adventures remain above the 20-turn reserve.&quot;);
        return false;
    }
    if (get_property(&quot;don_post_run_chow&quot;).to_boolean()) {
        if (have_outfit(&quot;chowDown&quot;)) chowDown();
        if (have_outfit(&quot;chowDown2&quot;)) chowDown2();
    }
    item bow = $item[toy cupid bow];
    if (available_amount(bow) &gt; 0 || have_equipped(bow)) {
        foreach other in $familiars[] {
            if (other != yeti &amp;&amp; familiar_equipped_equipment(other) == bow)
                if (!equip(other, $item[none])) {
                    don_error(&quot;Cannot release toy cupid bow from &quot; + other);
                    return false;
                }
        }
        if (familiar_equipped_equipment(yeti) != bow &amp;&amp; !equip(yeti, bow)) {
            don_error(&quot;Cannot equip toy cupid bow on Cooler Yeti.&quot;);
            return false;
        }
    } else {
        don_warning(&quot;Toy cupid bow unavailable; training without it.&quot;);
    }
    if (!can_adventure($location[The Dungeons of Doom])) {
        // The legacy dungeon unlockers may spend all remaining adventures.
        // Never run them automatically under a 20-adventure reserve.
        don_error(&quot;Dungeons of Doom locked. Run openDungeon()/EGTS()/DOD() independently before resuming.&quot;);
        return false;
    }
    if (!outfit(&quot;yetibuff&quot;) || !use_familiar(yeti)) {
        don_error(&quot;Could not prepare Yeti outfit/familiar.&quot;);
        return false;
    }
    while (my_adventures() &gt; 20 &amp;&amp; yeti.experience &lt; 400) {
        if (!adventure(1, $location[The Dungeons of Doom])) {
            don_error(&quot;Yeti training adventure failed.&quot;);
            return false;
        }
    }
    don_log(&quot;Cooler Yeti XP now &quot; + yeti.experience + &quot;/400.&quot;);
    if (yeti.experience &lt; 400) return false;
    set_property(&quot;don_post_run_stage&quot;, &quot;yeti_ready&quot;);
    don_post_run_track(&quot;postrun_yeti_ready&quot;);
    return true;
}</code></pre></article>
<article id="actual-11-61"><h2>don_yeti_adv <small>[11.61]</small></h2><p><code>void don_yeti_adv()</code></p><p>scripts/don_custom_functions.ash:1135–1135</p><p>function_actual11.61.2</p><pre><code>void don_yeti_adv() { don_post_run_yeti_stage(); }</code></pre></article>
<article id="actual-11-62"><h2>don_post_run_combo_stage <small>[11.62]</small></h2><p><code>boolean don_post_run_combo_stage()</code></p><p>scripts/don_custom_functions.ash:1137–1155</p><p>function_actual11.62.2</p><pre><code>boolean don_post_run_combo_stage() {
    don_post_run_sync_date();
    if ($familiar[cooler yeti].experience &lt; 400) {
        don_error(&quot;Cooler Yeti below 400 XP: refusing to start WaterSheep.&quot;);
        return false;
    }
    string stage_name = get_property(&quot;don_post_run_stage&quot;);
    if (stage_name == &quot;combo_done&quot; || stage_name == &quot;done&quot;) return true;
    int turns = my_adventures();
    if (turns &gt; 2) {
        if (!cli_execute(&quot;combo watersheep-&quot; + turns)) {
            don_error(&quot;WaterSheep combo command failed.&quot;);
            return false;
        }
    } else don_log(&quot;At two or fewer adventures; no WaterSheep turns needed.&quot;);
    set_property(&quot;don_post_run_stage&quot;, &quot;combo_done&quot;);
    don_post_run_track(&quot;postrun_combo_done&quot;);
    return true;
}</code></pre></article>
<article id="actual-11-63"><h2>don_post_run_eod_ready <small>[11.63]</small></h2><p><code>boolean don_post_run_eod_ready()</code></p><p>scripts/don_custom_functions.ash:1157–1165</p><p>function_actual11.63.2</p><pre><code>boolean don_post_run_eod_ready() {
    if (my_adventures() &gt; 2) return false;
    if (my_fullness() &lt; fullness_limit()) return false;
    if (my_spleen_use() &lt; spleen_limit()) return false;
    if (my_inebriety() &lt; inebriety_limit()) return false;
    if (my_familiar() != $familiar[Stooper]) return false;
    if (!is_wearing_outfit(&quot;maxorgan&quot;)) return false;
    return true;
}</code></pre></article>
<article id="actual-11-64"><h2>don_eod_process <small>[11.64]</small></h2><p><code>boolean don_eod_process()</code></p><p>scripts/don_custom_functions.ash:1167–1243</p><p>function_actual11.64.2</p><pre><code>boolean don_eod_process() {
    don_post_run_sync_date();
    if (get_property(&quot;don_post_run_stage&quot;) == &quot;done&quot;) {
        don_log(&quot;Post-run already completed for &quot; + today_to_string());
        return true;
    }
    int checkpoint = get_property(&quot;don_post_run_eod_step&quot;).to_int();
    // The nightcap and later Left-Hand Man steps change the state used by
    // the gate. Require original readiness only before the first EOD action.
    if (checkpoint == 0 &amp;&amp; !don_post_run_eod_ready()) {
        don_warning(&quot;EOD gate: need maxorgan, Stooper, full stomach/spleen/liver and &lt;=2 adventures.&quot;);
        don_post_run_status();
        return false;
    }
    if (checkpoint &lt; 1) {
        if ($familiar[cooler yeti].experience &gt;= 400 &amp;&amp; !don_get_cool()) return false;
        set_property(&quot;don_post_run_eod_step&quot;, &quot;1&quot;);
    }
    if (checkpoint &lt; 2) {
        // getCool() equips maxo and may change the current familiar.
        if (!outfit(&quot;maxorgan&quot;)) {
            don_error(&quot;Could not restore maxorgan before nightcap.&quot;);
            return false;
        }
        if (my_familiar() != $familiar[Stooper] &amp;&amp;
            !use_familiar($familiar[Stooper])) {
            don_error(&quot;Could not restore Stooper before nightcap.&quot;);
            return false;
        }
        if (!don_nightcap()) return false;
        set_property(&quot;don_post_run_eod_step&quot;, &quot;2&quot;);
    }
    if (checkpoint &lt; 3) {
        familiar lefty = $familiar[Left-Hand Man];
        if (!have_familiar(lefty) || !use_familiar(lefty)) {
            don_warning(&quot;Left-Hand Man unavailable. Retry EOD later.&quot;);
            return false;
        }
        set_property(&quot;don_post_run_eod_step&quot;, &quot;3&quot;);
    }
    if (checkpoint &lt; 4) {
        if (!cli_execute(&quot;genie effect offhand remarkable&quot;)) return false;
        set_property(&quot;don_post_run_eod_step&quot;, &quot;4&quot;);
    }
    if (checkpoint &lt; 5) {
        if (!cli_execute(&quot;max adv&quot;)) return false;
        set_property(&quot;don_post_run_eod_step&quot;, &quot;5&quot;);
    }
    if (checkpoint &lt; 6) {
        // No auto-answer to Philter&#39;s uncategorized-item prompt is assumed.
        if (get_property(&quot;don_post_run_philter&quot;).to_boolean()) {
            if (!cli_execute(&quot;philter&quot;)) {
                don_error(&quot;Philter failed or cancelled.&quot;);
                return false;
            }
        } else don_log(&quot;Philter skipped: don_post_run_philter=false.&quot;);
        set_property(&quot;don_post_run_eod_step&quot;, &quot;6&quot;);
    }
    if (checkpoint &lt; 7) {
        if (!cli_execute(&quot;mall-manager reprice&quot;)) return false;
        set_property(&quot;don_post_run_eod_step&quot;, &quot;7&quot;);
    }
    if (checkpoint &lt; 8) {
        if (!cli_execute(&quot;call buy-script.js&quot;)) return false;
        set_property(&quot;don_post_run_eod_step&quot;, &quot;8&quot;);
    }
    if (checkpoint &lt; 9) {
        int have_tickets = don_owned_amount($item[raffle ticket]);
        int need_tickets = max(0, 111 - have_tickets);
        if (need_tickets &gt; 0 &amp;&amp; !cli_execute(&quot;raffle &quot; + need_tickets)) return false;
        set_property(&quot;don_post_run_eod_step&quot;, &quot;9&quot;);
    }
    don_post_run_track(&quot;postrun_eod_complete&quot;);
    set_property(&quot;don_post_run_stage&quot;, &quot;done&quot;);
    don_good(&quot;Don post-run EOD complete.&quot;);
    return true;
}</code></pre></article>
<article id="actual-11-65"><h2>eod_proccess <small>[11.65]</small></h2><p><code>boolean eod_proccess()</code></p><p>scripts/don_custom_functions.ash:1246–1246</p><p>function_actual11.65.2</p><pre><code>boolean eod_proccess() { return don_eod_process(); }</code></pre></article>
<article id="actual-11-66"><h2>eod_process <small>[11.66]</small></h2><p><code>boolean eod_process()</code></p><p>scripts/don_custom_functions.ash:1247–1247</p><p>function_actual11.66.2</p><pre><code>boolean eod_process() { return don_eod_process(); }</code></pre></article>
<article id="actual-11-67"><h2>don_post_run_from <small>[11.67]</small></h2><p><code>boolean don_post_run_from(string entry_stage)</code></p><p>scripts/don_custom_functions.ash:1249–1279</p><p>function_actual11.67.2</p><pre><code>boolean don_post_run_from(string entry_stage) {
    don_post_run_sync_date();
    if (entry_stage == &quot;nightcap&quot;) return don_nightcap();
    if (entry_stage == &quot;eod&quot;) return eod_proccess();
    if (entry_stage == &quot;cool&quot;) return don_get_cool() &amp;&amp; eod_proccess();
    if (entry_stage == &quot;yeti&quot;) {
        if (!don_post_run_yeti_stage()) return false;
    } else if (entry_stage == &quot;&quot; || entry_stage == &quot;start&quot;) {
        if (get_property(&quot;don_post_run_stage&quot;) == &quot;done&quot;) return true;
        if (get_property(&quot;don_post_run_stage&quot;) == &quot;new&quot;) {
            if (!don_post_run_prepare()) return false;
        }
        if (get_property(&quot;don_post_run_stage&quot;) == &quot;prepared&quot;) {
            if (!don_post_run_yeti_stage()) return false;
        }
    } else {
        don_warning(&quot;Unknown post-run stage: &quot; + entry_stage);
        return false;
    }

    if (!don_post_run_combo_stage()) return false;
    // Reapply the EOD gate setup after the Yeti and farming stages.
    if (!outfit(&quot;maxorgan&quot;)) return false;
    if (have_familiar($familiar[Stooper]) &amp;&amp;
        !use_familiar($familiar[Stooper])) return false;
    if (!don_post_run_eod_ready()) {
        don_warning(&quot;WaterSheep returned; EOD requirements not met. Resume later with don-post-run eod.&quot;);
        return false;
    }
    return eod_proccess();
}</code></pre></article>
<article id="actual-11-68"><h2>don_post_run <small>[11.68]</small></h2><p><code>void don_post_run()</code></p><p>scripts/don_custom_functions.ash:1281–1281</p><p>function_actual11.68.2</p><pre><code>void don_post_run() { don_post_run_from(&quot;start&quot;); }</code></pre></article>
<article id="actual-11-69"><h2>don_login_default_true <small>[11.69]</small></h2><p><code>boolean don_login_default_true(string pref_name)</code></p><p>scripts/don_custom_functions.ash:1290–1293</p><p>function_actual11.69.2</p><pre><code>boolean don_login_default_true(string pref_name) {
    string raw_value = get_property(pref_name);
    return raw_value == &quot;&quot; || raw_value.to_boolean();
}</code></pre></article>
<article id="actual-11-70"><h2>don_login_second_allowed <small>[11.70]</small></h2><p><code>boolean don_login_second_allowed(int daily_ascensions)</code></p><p>scripts/don_custom_functions.ash:1295–1297</p><p>function_actual11.70.2</p><pre><code>boolean don_login_second_allowed(int daily_ascensions) {
    return daily_ascensions &gt; 0;
}</code></pre></article>
<article id="actual-11-71"><h2>don_login_sync_date <small>[11.71]</small></h2><p><code>void don_login_sync_date()</code></p><p>scripts/don_custom_functions.ash:1299–1306</p><p>function_actual11.71.2</p><pre><code>void don_login_sync_date() {
    string date_now = today_to_string();
    if (get_property(&quot;don_login_date&quot;) == date_now) return;
    set_property(&quot;don_login_date&quot;, date_now);
    set_property(&quot;don_login_stage&quot;, &quot;new&quot;);
    set_property(&quot;don_login_holiday&quot;, &quot;none&quot;);
    set_property(&quot;don_login_breakfast2_ascensions&quot;, &quot;0&quot;);
}</code></pre></article>
<article id="actual-11-72"><h2>don_login_track <small>[11.72]</small></h2><p><code>void don_login_track(string label)</code></p><p>scripts/don_custom_functions.ash:1308–1312</p><p>function_actual11.72.2</p><pre><code>void don_login_track(string label) {
    if (!get_property(&quot;don_login_ptrack&quot;).to_boolean()) return;
    if (!cli_execute(&quot;call ptrack.ash add &quot; + label))
        don_warning(&quot;Optional ptrack checkpoint failed: &quot; + label);
}</code></pre></article>
<article id="actual-11-73"><h2>don_login_install_aliases <small>[11.73]</small></h2><p><code>boolean don_login_install_aliases()</code></p><p>scripts/don_custom_functions.ash:1314–1320</p><p>function_actual11.73.2</p><pre><code>boolean don_login_install_aliases() {
    boolean good = cli_execute(&quot;alias don-login =&gt; call don_login.ash %%&quot;);
    if (!cli_execute(&quot;alias don-breakfast-1 =&gt; call don_login.ash breakfast_1&quot;)) good = false;
    if (!cli_execute(&quot;alias don-breakfast-2 =&gt; call don_login.ash breakfast_2&quot;)) good = false;
    if (!cli_execute(&quot;alias don-login-eod =&gt; call don_login.ash eod&quot;)) good = false;
    return good;
}</code></pre></article>
<article id="actual-11-74"><h2>don_login_status <small>[11.74]</small></h2><p><code>void don_login_status()</code></p><p>scripts/don_custom_functions.ash:1322–1330</p><p>function_actual11.74.2</p><pre><code>void don_login_status() {
    print(&quot;don_login_date = &quot; + get_property(&quot;don_login_date&quot;));
    print(&quot;don_login_stage = &quot; + get_property(&quot;don_login_stage&quot;));
    print(&quot;don_login_holiday = &quot; + get_property(&quot;don_login_holiday&quot;));
    print(&quot;ascensionsToday = &quot; + get_property(&quot;ascensionsToday&quot;).to_int());
    print(&quot;don_login_breakfast2_ascensions = &quot; + get_property(&quot;don_login_breakfast2_ascensions&quot;));
    print(&quot;breakfastCompleted = &quot; + get_property(&quot;breakfastCompleted&quot;).to_boolean());
    print(&quot;kingLiberated = &quot; + get_property(&quot;kingLiberated&quot;).to_boolean());
}</code></pre></article>
<article id="actual-11-75"><h2>don_login_help <small>[11.75]</small></h2><p><code>void don_login_help()</code></p><p>scripts/don_custom_functions.ash:1332–1343</p><p>function_actual11.75.2</p><pre><code>void don_login_help() {
    don_header(&quot;Don Login / breakfast_1 / breakfast_2&quot;);
    print(&quot;don-login help | status | breakfast_1 | breakfast_2 | postascend | eod | install&quot;);
    print(&quot;breakfast_1: combo watersheep-free, git update, tracking, raffle, holiday, breakfast, boneFarm, farming.&quot;);
    print(&quot;breakfast_2: requires ascensionsToday &gt; 0 and kingLiberated=true.&quot;);
    print(&quot;don_login_bone_farm = &quot; + don_login_default_true(&quot;don_login_bone_farm&quot;) + &quot; (default true)&quot;);
    print(&quot;don_login_default_garbo = &quot; + don_login_default_true(&quot;don_login_default_garbo&quot;) + &quot; (default true)&quot;);
    print(&quot;don_login_holidays = &quot; + don_login_default_true(&quot;don_login_holidays&quot;) + &quot; (default true)&quot;);
    print(&quot;don_login_ptrack = &quot; + get_property(&quot;don_login_ptrack&quot;).to_boolean());
    print(&quot;don_login_auto_eod = &quot; + get_property(&quot;don_login_auto_eod&quot;).to_boolean());
    don_breakfast_help();
}</code></pre></article>
<article id="actual-11-76"><h2>don_login_raffle_topup <small>[11.76]</small></h2><p><code>boolean don_login_raffle_topup()</code></p><p>scripts/don_custom_functions.ash:1345–1355</p><p>function_actual11.76.2</p><pre><code>boolean don_login_raffle_topup() {
    if (available_amount($item[134]) == 0 &amp;&amp;
        available_amount($item[pumpkin carriage]) == 0 &amp;&amp;
        available_amount($item[Desert Bus pass]) == 0) {
        don_log(&quot;Raffle access not detected; skipping top-up.&quot;);
        return true;
    }
    int needed = max(0, 111 - don_owned_amount($item[raffle ticket]));
    if (needed &lt;= 0) return true;
    return cli_execute(&quot;raffle &quot; + needed);
}</code></pre></article>
<article id="actual-11-77"><h2>don_login_detect_holiday <small>[11.77]</small></h2><p><code>string don_login_detect_holiday()</code></p><p>scripts/don_custom_functions.ash:1357–1366</p><p>function_actual11.77.2</p><pre><code>string don_login_detect_holiday() {
    if (!don_login_default_true(&quot;don_login_holidays&quot;)) return &quot;none&quot;;
    string page_html = visit_url(&quot;main.php&quot;);
    if (contains_text(page_html, &quot;Halloween&quot;)) return &quot;halloween&quot;;
    if (contains_text(page_html, &quot;Time Tower&quot;)) return &quot;time_tower&quot;;
    if (contains_text(page_html, &quot;Crimbo&quot;)) return &quot;crimbo&quot;;
    if (contains_text(page_html, &quot;Feast of Boris&quot;))
        don_log(&quot;Feast of Boris: regular farming route remains selected.&quot;);
    return &quot;none&quot;;
}</code></pre></article>
<article id="actual-11-78"><h2>don_login_bone_farm <small>[11.78]</small></h2><p><code>boolean don_login_bone_farm()</code></p><p>scripts/don_custom_functions.ash:1368–1371</p><p>function_actual11.78.2</p><pre><code>boolean don_login_bone_farm() {
    if (!don_login_default_true(&quot;don_login_bone_farm&quot;)) return true;
    return cli_execute(&quot;call boneFarm.ash&quot;);
}</code></pre></article>
<article id="actual-11-79"><h2>don_login_farming <small>[11.79]</small></h2><p><code>boolean don_login_farming()</code></p><p>scripts/don_custom_functions.ash:1373–1391</p><p>function_actual11.79.2</p><pre><code>boolean don_login_farming() {
    if (!don_breakfast_validate_modes()) return false;
    if (get_property(&quot;don_breakfast_cowo&quot;).to_boolean()) {
        if (!don_breakfast_is_pastamancer(my_class())) return false;
        return cli_execute(&quot;cowo&quot;);
    }
    if (get_property(&quot;don_breakfast_nobarf_combo&quot;).to_boolean()) {
        if (!cli_execute(&quot;nobarf&quot;)) return false;
        if (!cli_execute(&quot;refresh all&quot;)) return false;
        int turns_remaining = don_breakfast_combo_turns(my_adventures());
        return turns_remaining &lt; 1 || cli_execute(&quot;combo &quot; + turns_remaining);
    }
    if (get_property(&quot;don_breakfast_nobarf&quot;).to_boolean())
        return cli_execute(&quot;nobarf&quot;);
    if (get_property(&quot;don_breakfast_barf&quot;).to_boolean())
        return cli_execute(&quot;barf&quot;);
    if (!don_login_default_true(&quot;don_login_default_garbo&quot;)) return true;
    return cli_execute(&quot;barf1&quot;);
}</code></pre></article>
<article id="actual-11-80"><h2>don_login_breakfast_1 <small>[11.80]</small></h2><p><code>boolean don_login_breakfast_1()</code></p><p>scripts/don_custom_functions.ash:1395–1480</p><p>function_actual11.80.2</p><pre><code>boolean don_login_breakfast_1() {
    don_login_sync_date();
    string stage_name = get_property(&quot;don_login_stage&quot;);
    if (stage_name == &quot;done&quot; || stage_name == &quot;in_run_done&quot; ||
        stage_name == &quot;already_breakfast&quot;) {
        don_log(&quot;breakfast_1 already handled today.&quot;);
        return true;
    }
    // Required first and second CLI actions, in this exact order.
    if (stage_name == &quot;new&quot;) {
        set_property(&quot;don_login_stage&quot;, &quot;free_running&quot;);
        if (!cli_execute(&quot;combo watersheep-free&quot;)) return false;
        set_property(&quot;don_login_stage&quot;, &quot;free_done&quot;);
        stage_name = &quot;free_done&quot;;
    }
    if (stage_name == &quot;free_done&quot;) {
        set_property(&quot;don_login_stage&quot;, &quot;update_running&quot;);
        if (!cli_execute(&quot;git update&quot;)) return false;
        set_property(&quot;don_login_stage&quot;, &quot;update_done&quot;);
        stage_name = &quot;update_done&quot;;
    }
    if (stage_name == &quot;update_done&quot;) {
        if (!don_login_install_aliases())
            don_warning(&quot;Could not install every don-login alias.&quot;);
        set_property(&quot;don_login_stage&quot;, &quot;aliases_done&quot;);
        stage_name = &quot;aliases_done&quot;;
    }
    if (stage_name == &quot;aliases_done&quot;) {
        set_property(&quot;don_login_stage&quot;, &quot;checks_running&quot;);
        don_header(&quot;Don login: &quot; + Day() + &quot; &quot; + today_to_string());
        don_log(&quot;Bounty item: &quot; + to_item(get_property(&quot;currentBountyItem&quot;)));
        if (!cli_execute(&quot;counters&quot;)) don_warning(&quot;Counters report unavailable.&quot;);
        if (!cli_execute(&quot;conditions&quot;)) don_warning(&quot;Conditions report unavailable.&quot;);
        don_login_track(&quot;login_start&quot;);
        if (!don_login_raffle_topup()) return false;
        set_property(&quot;don_login_holiday&quot;, don_login_detect_holiday());
        set_property(&quot;don_login_stage&quot;, &quot;checks_done&quot;);
        stage_name = &quot;checks_done&quot;;
    }
    if (stage_name == &quot;checks_done&quot;) {
        if (get_property(&quot;breakfastCompleted&quot;).to_boolean()) {
            don_warning(&quot;Native breakfast was completed before breakfast_1; no automatic Garbo.&quot;);
            set_property(&quot;don_login_stage&quot;, &quot;already_breakfast&quot;);
            return true;
        }
        if (!get_property(&quot;kingLiberated&quot;).to_boolean()) {
            set_property(&quot;don_login_stage&quot;, &quot;in_run_running&quot;);
            if (!cli_execute(&quot;breakfast&quot;)) return false;
            set_property(&quot;don_login_stage&quot;, &quot;in_run_done&quot;);
            return true;
        }
        set_property(&quot;don_login_stage&quot;, &quot;breakfast_running&quot;);
        if (!don_breakfast_prepare_daily()) return false;
        set_property(&quot;don_login_stage&quot;, &quot;breakfast_done&quot;);
        don_login_track(&quot;breakfast_1_done&quot;);
        stage_name = &quot;breakfast_done&quot;;
    }
    if (stage_name == &quot;breakfast_done&quot;) {
        string holiday_name = get_property(&quot;don_login_holiday&quot;);
        if (holiday_name != &quot;&quot; &amp;&amp; holiday_name != &quot;none&quot;) {
            set_property(&quot;don_login_stage&quot;, &quot;holiday_running&quot;);
            if (holiday_name == &quot;halloween&quot; &amp;&amp; !cli_execute(&quot;freecandy&quot;))
                return false;
            if ((holiday_name == &quot;time_tower&quot; || holiday_name == &quot;crimbo&quot;) &amp;&amp;
                !cli_execute(&quot;nobarf&quot;)) return false;
            set_property(&quot;don_login_stage&quot;, &quot;done&quot;);
            return true;
        }
        set_property(&quot;don_login_stage&quot;, &quot;bone_running&quot;);
        if (!don_login_bone_farm()) return false;
        set_property(&quot;don_login_stage&quot;, &quot;bone_done&quot;);
        stage_name = &quot;bone_done&quot;;
    }
    if (stage_name == &quot;bone_done&quot;) {
        set_property(&quot;don_login_stage&quot;, &quot;farm_running&quot;);
        if (!don_login_farming()) return false;
        set_property(&quot;don_login_stage&quot;, &quot;done&quot;);
        don_login_track(&quot;login_farm_done&quot;);
        if (get_property(&quot;don_login_auto_eod&quot;).to_boolean())
            return don_post_run_from(&quot;start&quot;);
        return true;
    }
    don_warning(&quot;don_login paused at stage &quot; + get_property(&quot;don_login_stage&quot;) +
                &quot;; inspect actions before manually repairing the checkpoint.&quot;);
    return false;
}</code></pre></article>
<article id="actual-11-81"><h2>don_login_breakfast_2 <small>[11.81]</small></h2><p><code>boolean don_login_breakfast_2()</code></p><p>scripts/don_custom_functions.ash:1483–1507</p><p>function_actual11.81.2</p><pre><code>boolean don_login_breakfast_2() {
    int daily_count = get_property(&quot;ascensionsToday&quot;).to_int();
    if (!don_login_second_allowed(daily_count)) {
        don_warning(&quot;breakfast_2 requires ascensionsToday &gt; 0.&quot;);
        return false;
    }
    if (!get_property(&quot;kingLiberated&quot;).to_boolean()) {
        don_warning(&quot;breakfast_2 requires kingLiberated=true.&quot;);
        return false;
    }
    don_login_sync_date();
    if (get_property(&quot;don_login_breakfast2_ascensions&quot;).to_int() &gt;= daily_count) {
        don_log(&quot;breakfast_2 already attempted for ascension #&quot; + daily_count);
        return true;
    }
    set_property(&quot;don_login_breakfast2_ascensions&quot;, daily_count);
    don_login_track(&quot;breakfast_2_start&quot;);
    if (!don_breakfast_prepare_daily()) return false;
    if (!don_login_bone_farm()) return false;
    if (!don_login_farming()) return false;
    don_login_track(&quot;breakfast_2_done&quot;);
    if (get_property(&quot;don_login_auto_eod&quot;).to_boolean())
        return don_post_run_from(&quot;start&quot;);
    return true;
}</code></pre></article>
<article id="actual-11-82"><h2>don_login_eod <small>[11.82]</small></h2><p><code>boolean don_login_eod()</code></p><p>scripts/don_custom_functions.ash:1509–1512</p><p>function_actual11.82.2</p><pre><code>boolean don_login_eod() {
    don_login_track(&quot;login_eod_start&quot;);
    return don_post_run_from(&quot;eod&quot;);
}</code></pre></article>
<article id="actual-11-83"><h2>don_login <small>[11.83]</small></h2><p><code>void don_login()</code></p><p>scripts/don_custom_functions.ash:1514–1514</p><p>function_actual11.83.2</p><pre><code>void don_login() { don_login_breakfast_1(); }</code></pre></article></body></html>
